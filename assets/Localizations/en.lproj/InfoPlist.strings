<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Backlit analyzes system playback locally to make your logo respond to music. No audio is recorded or uploaded.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect the Backlit logo light to your Home Assistant instance on your local network.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Backlit uses system playback audio for Music mode. It does not save or transmit screen or audio content.</string>
</dict>
</plist>
