    "Input Monitoring is allowed, but macOS could not create the typing event listener. Reopen Backlit and retry.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Monitoring is allowed, but macOS could not create the typing event listener. Reopen Backlit and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorización de entrada está permitida, pero macOS no pudo crear el receptor de eventos de escritura. Vuelve a abrir Backlit y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillance de l’entrée est autorisée, mais macOS n’a pas pu créer le récepteur d’événements de saisie. Rouvrez Backlit et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabeüberwachung ist erlaubt, aber macOS konnte keinen Listener für Tippereignisse erstellen. Öffnen Sie Backlit erneut und versuchen Sie es noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視は許可されていますが、macOSがタイピングイベントのリスナーを作成できませんでした。Backlitを開き直して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 모니터링은 허용되었지만 macOS가 타이핑 이벤트 리스너를 만들지 못했습니다. Backlit을 다시 열고 재시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Monitoramento de Entrada está permitido, mas o macOS não conseguiu criar o receptor de eventos de digitação. Reabra o Backlit e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许输入监控，但 macOS 无法创建打字事件监听器。请重新打开 Backlit 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
