    "Press Command, Control or Option with a regular key. Escape cancels.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Command, Control or Option with a regular key. Escape cancels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Command, Control u Option con una tecla normal. Escape cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Command, Control ou Option avec une touche standard. Échap annule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, Control oder Option zusammen mit einer normalen Taste drücken. Escape bricht ab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command、Control、Optionのいずれかと通常のキーを押してください。Escapeでキャンセルします。"
