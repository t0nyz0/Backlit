    "Preview uses a sample waveform. Live system audio is never started in preview.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview uses a sample waveform. Live system audio is never started in preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa usa una onda de ejemplo. Nunca se inicia el audio real del sistema en la vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu utilise une forme d’onde d’exemple. Le son réel du système n’est jamais activé dans l’aperçu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau verwendet eine Beispielwellenform. Live-Systemaudio wird darin nie gestartet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューではサンプル波形を使い、実際のシステムオーディオは開始しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기는 샘플 파형을 사용하며 실제 시스템 오디오는 시작하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia usa uma forma de onda de exemplo. O áudio real do sistema nunca é iniciado na prévia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览使用示例波形，绝不会启动实时系统音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽使用示例波形，絕不會啓動實時系統音訊。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างใช้รูปคลื่นจำลอง ไม่เริ่มเสียงระบบจริงในโหมดตัวอย่าง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anteprima usa una forma d’onda di esempio. Non avvia mai l’audio di sistema reale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorvertoning gebruikt een voorbeeldgolfvorm. Systeemgeluid wordt in de voorvertoning nooit gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd korzysta z przykładowego przebiegu dźwięku. W podglądzie nigdy nie jest uruchamiany rzeczywisty dźwięk systemowy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizleme bir örnek dalga biçimi kullanır. Önizlemede canlı sistem sesi asla başlatılmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ xem trước dùng dạng sóng mẫu và không bao giờ khởi động âm thanh hệ thống thật."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau menggunakan contoh bentuk gelombang. Audio sistem langsung tidak pernah dimulai dalam pratinjau."
          }
        }
      }
    },
