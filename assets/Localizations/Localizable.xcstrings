      }
    },
    "Another controller changed the logo or its state is unavailable. Recovery was retained.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another controller changed the logo or its state is unavailable. Recovery was retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro controlador modificó el logo o su estado no está disponible. Se conservó la información de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre contrôleur a modifié le logo ou son état est indisponible. Les données de restauration ont été conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Steuerung hat das Logo geändert oder sein Status ist nicht verfügbar. Wiederherstellungsdaten bleiben erhalten."
          }
