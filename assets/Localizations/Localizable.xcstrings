    "Quitting restores the native logo settings saved before this Backlit session. The logo may turn on again.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting restores the native logo settings saved before this Backlit session. The logo may turn on again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al salir se restauran los ajustes nativos del logo guardados antes de esta sesión de Backlit. El logo puede volver a encenderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter restaure les réglages natifs du logo enregistrés avant cette session Backlit. Le logo peut se rallumer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Beenden werden die vor dieser Backlit-Sitzung gespeicherten nativen Logoeinstellungen wiederhergestellt. Das Logo kann wieder angehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了すると、このBacklitセッションの開始前に保存した元のロゴ設定に戻ります。ロゴが再び点灯する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료하면 이 Backlit 세션 전에 저장한 원래 로고 설정으로 복원됩니다. 로고가 다시 켜질 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair restaura os ajustes nativos do logo salvos antes desta sessão do Backlit. O logo pode acender novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出时会恢复本次 Backlit 会话之前保存的原生徽标设置，徽标可能再次亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
