    "Ambient brightness limits were not changed.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambient brightness limits were not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se modificaron los límites de brillo ambiental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites de luminosité ambiante n’ont pas été modifiées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgebungshelligkeitsgrenzen wurden nicht geändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境光による明るさ制限は変更されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변광 밝기 제한은 변경되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os limites de brilho ambiente não foram alterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未更改环境光亮度限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未更改環境光亮度限制。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้เปลี่ยนขีดจำกัดความสว่างตามแสงแวดล้อม"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti di luminosità ambientale non sono stati modificati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De limieten voor omgevingshelderheid zijn niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zmieniono ograniczeń jasności zależnych od oświetlenia otoczenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortam ışığına bağlı parlaklık sınırları değiştirilmedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới hạn độ sáng theo ánh sáng môi trường không thay đổi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas kecerahan sekitar tidak diubah."
          }
        }
      }
    },
    "An update is waiting. Choose Install Update and Relaunch, or skip it in the update window before quitting.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update is waiting. Choose Install Update and Relaunch, or skip it in the update window before quitting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una actualización pendiente. Elige Instalar actualización y reiniciar o sáltala en la ventana de actualización antes de salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour est en attente. Choisissez Installer la mise à jour et relancer, ou ignorez-la dans la fenêtre de mise à jour avant de quitter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Update wartet. „Update installieren und neu starten“ wählen oder das Update vor dem Beenden im Updatefenster überspringen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが待機中です。「アップデートをインストールして再起動」を選ぶか、終了前にアップデート画面でスキップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 대기 중입니다. ‘업데이트 설치 후 다시 실행’을 선택하거나 종료 전에 업데이트 창에서 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma atualização aguardando. Escolha Instalar atualização e reabrir ou ignore-a na janela de atualização antes de sair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新等待安装。请选择“安装更新并重新启动”，或在退出前于更新窗口中跳过它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有更新等待安裝。請選擇“安裝更新並重新啓動”，或在退出前於更新窗口中跳過它。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีอัปเดตรออยู่ เลือก “ติดตั้งอัปเดตแล้วเปิดใหม่” หรือข้ามในหน้าต่างอัปเดตก่อนออก"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile un aggiornamento. Prima di uscire, seleziona «Installa aggiornamento e riavvia» oppure ignoralo nella finestra di aggiornamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staat een update klaar. Kies ‘Installeer update en start opnieuw’ of sla de update over in het updatevenster voordat je stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja jest gotowa. Wybierz „Zainstaluj aktualizację i uruchom ponownie” lub pomiń ją w oknie aktualizacji przed zakończeniem pracy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir güncelleme bekliyor. Çıkmadan önce güncelleme penceresinde “Güncellemeyi Yükle ve Yeniden Aç”ı seçin veya güncellemeyi atlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có bản cập nhật đang chờ. Chọn Cài đặt bản cập nhật và mở lại, hoặc bỏ qua bản cập nhật trong cửa sổ cập nhật trước khi thoát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada pembaruan yang menunggu. Pilih Instal Pembaruan dan Buka Kembali, atau lewati pembaruan di jendelanya sebelum keluar."
          }
        }
      }
    },
    "Another controller changed the logo or its state is unavailable. Recovery was retained.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another controller changed the logo or its state is unavailable. Recovery was retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro controlador modificó el logo o su estado no está disponible. Se conservó la información de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre contrôleur a modifié le logo ou son état est indisponible. Les données de restauration ont été conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Steuerung hat das Logo geändert oder sein Status ist nicht verfügbar. Wiederherstellungsdaten bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の制御アプリがロゴを変更したか、状態を取得できません。復元情報は保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 제어 앱이 로고를 변경했거나 상태를 확인할 수 없습니다. 복구 정보는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro controlador alterou o logo ou seu estado está indisponível. Os dados de recuperação foram preservados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他控制程序更改了徽标，或其状态不可用。已保留恢复数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他控制程序更改了標誌，或其狀態不可用。已保留恢複數據。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมอื่นเปลี่ยนโลโก้หรือไม่สามารถตรวจสถานะได้ โดยคงข้อมูลกู้คืนไว้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro controller ha modificato il logo o il suo stato non è disponibile. Il record di recupero è stato conservato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere regelaar heeft het logo gewijzigd of de status is niet beschikbaar. De herstelinformatie is bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny kontroler zmienił ustawienia logo lub nie można odczytać jego stanu. Zachowano dane odzyskiwania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir denetleyici logoyu değiştirdi veya logo durumu okunamadı. Kurtarma bilgileri saklandı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bộ điều khiển khác đã thay đổi đèn logo hoặc không đọc được trạng thái của đèn. Thông tin khôi phục vẫn được giữ lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengendali lain mengubah logo atau statusnya tidak tersedia. Catatan pemulihan dipertahankan."
          }
        }
      }
    },
    "Another controller changed the logo. Backlit stopped writing; recovery is retained.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another controller changed the logo. Backlit stopped writing; recovery is retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro controlador modificó el logo. Backlit dejó de realizar cambios; se conserva la información de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre contrôleur a modifié le logo. Backlit a cessé d’y apporter des changements ; les données de restauration sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Steuerung hat das Logo geändert. Backlit schreibt nicht mehr; die Wiederherstellungsdaten bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の制御アプリがロゴを変更しました。Backlitは設定の書き込みを停止し、復元情報を保持しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 제어 앱이 로고를 변경했습니다. Backlit은 설정 쓰기를 중단했으며 복구 정보는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro controlador alterou o logo. O Backlit parou de fazer alterações; os dados de recuperação foram preservados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他控制程序更改了徽标。Backlit 已停止写入，并保留恢复数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他控制程序更改了標誌。Backlit 已停止寫入，並保留恢複數據。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมอื่นเปลี่ยนโลโก้ Backlit หยุดเขียนค่าแล้ว โดยคงข้อมูลกู้คืนไว้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro controller ha modificato il logo. Backlit ha interrotto le modifiche e ha conservato il record di recupero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere regelaar heeft het logo gewijzigd. Backlit wijzigt niets meer. De herstelinformatie is bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny kontroler zmienił ustawienia logo. Backlit przestał je zmieniać; dane odzyskiwania zostały zachowane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir denetleyici logoyu değiştirdi. Backlit logoda değişiklik yapmayı bıraktı; kurtarma bilgileri saklandı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bộ điều khiển khác đã thay đổi đèn logo. Backlit đã ngừng áp dụng thay đổi và giữ lại thông tin khôi phục."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengendali lain mengubah logo. Backlit berhenti mengubahnya; catatan pemulihan dipertahankan."
          }
        }
      }
    },
