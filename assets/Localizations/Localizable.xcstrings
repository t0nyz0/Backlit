    "Battery controls its own brightness. Select a manual behavior to use brightness shortcuts.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery controls its own brightness. Select a manual behavior to use brightness shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Batería controla su propio brillo. Elige un comportamiento manual para usar los atajos de brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterie contrôle sa propre luminosité. Choisissez un comportement manuel pour utiliser les raccourcis de luminosité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akkumodus regelt die Helligkeit selbst. Für Helligkeitskurzbefehle ein manuelles Verhalten wählen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーモードでは明るさを自動調整します。明るさのショートカットを使うには手動の動作を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 모드는 밝기를 자동으로 제어합니다. 밝기 단축키를 사용하려면 수동 동작을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria controla o próprio brilho. Escolha um comportamento manual para usar os atalhos de brilho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池模式自行控制亮度。请选择手动模式后使用亮度快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池模式自行控制亮度。請選擇手動模式後使用亮度快捷鍵。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหมดแบตเตอรี่ควบคุมความสว่างเอง เลือกรูปแบบที่ปรับเองเพื่อใช้ปุ่มลัดความสว่าง"
          }
        }
      }
    },
