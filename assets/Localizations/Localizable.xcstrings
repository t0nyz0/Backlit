    "Quitting restores the native logo settings saved before this Backlit session. The logo may turn on again.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting restores the native logo settings saved before this Backlit session. The logo may turn on again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al salir se restauran los ajustes nativos del logo guardados antes de esta sesión de Backlit. El logo puede volver a encenderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter restaure les réglages natifs du logo enregistrés avant cette session Backlit. Le logo peut se rallumer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Beenden werden die vor dieser Backlit-Sitzung gespeicherten nativen Logoeinstellungen wiederhergestellt. Das Logo kann wieder angehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了すると、このBacklitセッションの開始前に保存した元のロゴ設定に戻ります。ロゴが再び点灯する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료하면 이 Backlit 세션 전에 저장한 원래 로고 설정으로 복원됩니다. 로고가 다시 켜질 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair restaura os ajustes nativos do logo salvos antes desta sessão do Backlit. O logo pode acender novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出时会恢复本次 Backlit 会话之前保存的原生徽标设置，徽标可能再次亮起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退出時會恢復本次 Backlit 會話之前保存的原生徽標設定，徽標可能再次亮起。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อออกจะคืนการตั้งค่าโลโก้เดิมที่บันทึกก่อนเซสชัน Backlit นี้ โลโก้อาจสว่างอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscendo ripristini le impostazioni native del logo salvate prima di questa sessione di Backlit. Il logo potrebbe riaccendersi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je stopt, worden de systeemeigen logo-instellingen van vóór deze Backlit-sessie hersteld. Het logo kan weer aangaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończenie pracy przywróci systemowe ustawienia logo zapisane przed rozpoczęciem tej sesji Backlit. Logo może ponownie się włączyć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıktığınızda bu Backlit oturumundan önce kaydedilen yerleşik logo ayarları geri yüklenir. Logo yeniden yanabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thoát, hệ thống sẽ khôi phục cài đặt đèn logo gốc đã lưu trước phiên Backlit này. Đèn logo có thể sáng lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar akan memulihkan pengaturan logo bawaan yang disimpan sebelum sesi Backlit ini. Logo mungkin menyala kembali."
          }
        }
      }
    },
