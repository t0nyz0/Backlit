    "System audio starts with Music when your light is on and your Mac is active.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio starts with Music when your light is on and your Mac is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio del sistema se inicia con Música cuando la luz está encendida y el Mac está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son du système démarre avec Musique lorsque la lumière est allumée et votre Mac actif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemaudio startet im Musikmodus, wenn Ihr Licht an und Ihr Mac aktiv ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトがオンでMacが使用中の場合、音楽モードでシステムオーディオが開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명이 켜져 있고 Mac이 활성 상태일 때 음악 모드와 함께 시스템 오디오가 시작됩니다."
          }
        },
