    "Setup command copied. Run it locally in your agent's terminal, then check its MCP connections.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup command copied. Run it locally in your agent's terminal, then check its MCP connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando de configuración copiado. Ejecútalo localmente en el terminal del agente y comprueba sus conexiones MCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande de configuration copiée. Exécutez-la localement dans le terminal de votre agent, puis vérifiez ses connexions MCP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einrichtungsbefehl kopiert. Lokal im Terminal Ihres Agenten ausführen, dann dessen MCP-Verbindungen prüfen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定コマンドをコピーしました。このMacのエージェントのターミナルで実行し、MCP接続を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 명령을 복사했습니다. 이 기기의 에이전트 터미널에서 실행한 다음 MCP 연결을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando de configuração copiado. Execute-o localmente no terminal do agente e confira as conexões MCP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制设置命令。请在代理的本地终端中运行，然后检查其 MCP 连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製設定命令。請在代理的本地終端中運行，然後檢查其 MCP 連接。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกคำสั่งตั้งค่าแล้ว รันภายในเครื่องในเทอร์มินัลของเอเจนต์ แล้วตรวจการเชื่อมต่อ MCP"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comando di configurazione copiato. Eseguilo in locale nel terminale dell’agente, poi controlla le sue connessioni MCP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuratiecommando gekopieerd. Voer het lokaal uit in de terminal van je agent en controleer vervolgens de MCP-verbindingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano polecenie konfiguracji. Uruchom je lokalnie w terminalu agenta, a potem sprawdź jego połączenia MCP."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum komutu kopyalandı. Komutu ajanınızın terminalinde yerel olarak çalıştırın, ardından MCP bağlantılarını denetleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép lệnh thiết lập. Chạy lệnh cục bộ trong trình dòng lệnh của tác nhân, rồi kiểm tra các kết nối MCP của tác nhân."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah penyiapan disalin. Jalankan secara lokal di terminal agen Anda, lalu periksa koneksi MCP-nya."
          }
        }
      }
    },
