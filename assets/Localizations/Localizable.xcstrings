    "Hardware brightness keys are left to macOS. Use an arrow, letter or other regular key.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware brightness keys are left to macOS. Use an arrow, letter or other regular key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas físicas de brillo quedan a cargo de macOS. Usa una flecha, una letra u otra tecla normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches physiques de luminosité restent gérées par macOS. Utilisez une flèche, une lettre ou une autre touche standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardware-Helligkeitstasten bleiben macOS vorbehalten. Verwenden Sie eine Pfeiltaste, einen Buchstaben oder eine andere normale Taste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェアの明るさキーはmacOSに任せます。矢印、文字、その他の通常のキーを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드웨어 밝기 키는 macOS에서 처리합니다. 화살표, 문자 또는 다른 일반 키를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas físicas de brilho ficam sob controle do macOS. Use uma seta, letra ou outra tecla comum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬件亮度键交由 macOS 处理。请使用方向键、字母或其他普通按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "硬體亮度鍵交由 macOS 處理。請使用方向鍵、字母或其他普通按鍵。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มความสว่างฮาร์ดแวร์ให้ macOS จัดการ ใช้ปุ่มลูกศร ตัวอักษร หรือปุ่มทั่วไปอื่น"
          }
        }
      }
    },
