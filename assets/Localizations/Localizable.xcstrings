        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelta salvata. In attesa che il Mac e la luce siano pronti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Keuze opgeslagen. Wacht tot je Mac en licht klaar zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamiętano. Oczekiwanie na gotowość Maca i podświetlenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim hatırlandı. Mac’inizin ve ışığın hazır olması bekleniyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu lựa chọn. Đang chờ máy Mac và đèn sẵn sàng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan disimpan. Menunggu Mac dan lampu siap."
          }
        }
      }
    },
    "Remembered. Waiting to verify the previous session before reconnecting.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered. Waiting to verify the previous session before reconnecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Esperando a verificar la sesión anterior antes de reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé. En attente de vérification de la session précédente avant la reconnexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Vor der Neuverbindung wird die vorherige Sitzung geprüft."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存しました。再接続の前に前回のセッションの確認を待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장했습니다. 다시 연결하기 전에 이전 세션 확인을 기다리는 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo. Aguardando a verificação da sessão anterior antes de reconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记住。重新连接前正在等待验证上一会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記住。重新連接前正在等待驗證上一會話。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดจำไว้แล้ว กำลังรอยืนยันเซสชันก่อนหน้าก่อนเชื่อมต่อใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scelta salvata. In attesa di verificare la sessione precedente prima di riconnettere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Keuze opgeslagen. Wacht op controle van de vorige sessie voordat er opnieuw wordt verbonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamiętano. Oczekiwanie na weryfikację poprzedniej sesji przed ponownym połączeniem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim hatırlandı. Yeniden bağlanmadan önce önceki oturumun doğrulanması bekleniyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu lựa chọn. Đang chờ xác minh phiên trước khi kết nối lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan disimpan. Menunggu verifikasi sesi sebelumnya sebelum menyambungkan kembali."
          }
        }
      }
    },
