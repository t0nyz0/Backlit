    "Quitting restores the native logo settings saved before this Backlit session. The logo may turn on again.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting restores the native logo settings saved before this Backlit session. The logo may turn on again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al salir se restauran los ajustes nativos del logo guardados antes de esta sesión de Backlit. El logo puede volver a encenderse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter restaure les réglages natifs du logo enregistrés avant cette session Backlit. Le logo peut se rallumer."
