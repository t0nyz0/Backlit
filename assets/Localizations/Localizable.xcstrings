          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang membersihkan. Pilihan Anda disimpan."
          }
        }
      }
    },
    "Cleanup returned, but saved closed-lid handback remains unconfirmed.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup returned, but saved closed-lid handback remains unconfirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intento de limpieza terminó, pero sigue sin confirmarse la devolución del control guardada para la tapa cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tentative de nettoyage est terminée, mais le retour de contrôle enregistré pour le capot fermé reste non confirmé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung zurückgemeldet, aber die Rückgabe der Deckelsteuerung ist weiterhin unbestätigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後処理は終了しましたが、保存済みの閉じた画面のセッションの制御返却は未確認です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 작업이 반환되었지만 저장된 덮개 닫힘 세션의 제어 반환은 아직 확인되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tentativa de limpeza terminou, mas a devolução do controle salva para a tampa fechada continua sem confirmação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理已返回，但仍未确认已交还保存的合盖控制权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理已返回，但仍未確認已交還保存的合蓋控制權。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอนล้างสถานะกลับมาแล้ว แต่ยังยืนยันการคืนการควบคุมของเซสชันปิดฝาจอที่บันทึกไว้ไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La procedura a coperchio chiuso è terminata, ma non è confermato il ripristino del controllo da parte di macOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het opruimen is afgerond, maar het is niet bevestigd dat macOS de bediening terugheeft voor de opgeslagen sessie met gesloten deksel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządkowanie zakończyło się, ale nie potwierdzono oddania systemowi sterowania przy zapisanej opcji zamkniętej pokrywy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizleme tamamlandı, ancak kayıtlı kapalı kapak oturumunun denetimi sisteme geri verdiği doğrulanmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thực hiện dọn dẹp nhưng chưa xác nhận hệ thống đã tiếp quản lại trạng thái đóng nắp đã lưu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan selesai, tetapi pengembalian kendali untuk sesi penutup tertutup belum terkonfirmasi."
          }
        }
      }
    },
    "Closed-lid cleanup could not be confirmed. Review power recovery in Settings, then retry.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid cleanup could not be confirmed. Review power recovery in Settings, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la limpieza de la sesión con tapa cerrada. Revisa la recuperación de energía en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la session capot fermé n’a pas pu être confirmé. Vérifiez la restauration de l’alimentation dans Réglages, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelbereinigung konnte nicht bestätigt werden. Energiewiederherstellung in den Einstellungen prüfen, dann erneut versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた画面のセッションの後処理を確認できませんでした。設定で電源の復元を確認してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 닫힘 세션의 정리를 확인하지 못했습니다. 설정에서 전원 복구를 검토한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a limpeza da sessão com a tampa fechada. Revise a recuperação de energia em Ajustes e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认合盖清理结果。请在设置中检查电源恢复，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認合蓋清理結果。請在設定中檢查電源恢復，然後重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการล้างสถานะเมื่อปิดฝาจอไม่ได้ ตรวจการกู้คืนพลังงานในการตั้งค่าแล้วลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare il ripristino a coperchio chiuso. Controlla il recupero dell’alimentazione in Impostazioni e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opruimen bij gesloten deksel kon niet worden bevestigd. Controleer het energieherstel in Instellingen en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić zakończenia sesji z zamkniętą pokrywą. Sprawdź opcje odzyskiwania zasilania w ustawieniach i spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı kapak oturumunun temizlendiği doğrulanamadı. Ayarlar’da güç kurtarma seçeneklerini gözden geçirip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác nhận được việc dọn dẹp sau khi đóng nắp. Xem phần khôi phục nguồn trong Cài đặt, rồi thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan sesi dengan penutup tertutup tidak dapat dikonfirmasi. Tinjau pemulihan daya di Pengaturan, lalu coba lagi."
          }
        }
      }
    },
    "Closed-lid cleanup is in progress. Retry Restore Light when it finishes.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid cleanup is in progress. Retry Restore Light when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza de la sesión con tapa cerrada está en curso. Vuelve a usar Restaurar luz cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la session capot fermé est en cours. Réessayez Restaurer la lumière une fois terminé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelbereinigung läuft. Danach „Licht wiederherstellen“ erneut versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた画面のセッションの後処理中です。完了後に「ライトを復元」を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 닫힘 세션을 정리 중입니다. 완료되면 ‘조명 복원’을 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza da sessão com a tampa fechada está em andamento. Tente Restaurar luz novamente quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在清理合盖会话。完成后请重试“恢复灯光”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在清理合蓋會話。完成後請重試“恢復燈光”。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังล้างสถานะเมื่อปิดฝาจอ ลอง “กู้คืนไฟ” อีกครั้งเมื่อเสร็จ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristino a coperchio chiuso in corso. Riprova «Ripristina luce» una volta terminato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met opruimen na een sessie met gesloten deksel. Probeer ‘Licht herstellen’ opnieuw zodra dit klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa porządkowanie sesji z zamkniętą pokrywą. Po zakończeniu ponownie wybierz „Przywróć podświetlenie”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı kapak oturumu temizleniyor. Bittiğinde “Işığı Geri Yükle”yi tekrar seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang dọn dẹp phiên đóng nắp. Hãy thử lại Khôi phục đèn khi hoàn tất."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan sesi dengan penutup tertutup sedang berlangsung. Coba Pulihkan Lampu lagi setelah selesai."
          }
        }
      }
    },
