        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鈎子需要檢查 · 請重新連接或檢查代理設定"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฮุกต้องได้รับการตรวจสอบ · เชื่อมต่อใหม่หรือตรวจการตั้งค่าเอเจนต์"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook da verificare · riconnetti o controlla le impostazioni dell’agente"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de hooks · verbind opnieuw of controleer de agentinstellingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haki wymagają sprawdzenia · połącz ponownie lub sprawdź ustawienia agenta"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kancalar gözden geçirilmeli · yeniden bağlanın veya ajan ayarlarını denetleyin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần xem lại hook · kết nối lại hoặc kiểm tra cài đặt tác nhân"
          }
