    "Keep Backlit in the menu bar. Hiding the menu bar icon restores the Dock icon first.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Backlit in the menu bar. Hiding the menu bar icon restores the Dock icon first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Backlit en la barra de menús. Al ocultar su icono, primero se restablece el icono del Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez Backlit dans la barre des menus. Masquer son icône rétablit d’abord l’icône du Dock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit in der Menüleiste behalten. Vor dem Ausblenden wird das Dock-Symbol wiederhergestellt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlitをメニューバーに表示します。メニューバーのアイコンを隠すと、先にDockアイコンが再表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit을 메뉴 막대에 표시합니다. 메뉴 막대 아이콘을 숨기면 먼저 Dock 아이콘이 다시 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Backlit na barra de menus. Ao ocultar esse ícone, o ícone do Dock é restaurado primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中保留 Backlit。隐藏菜单栏图标前会先恢复 Dock 图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜單欄中保留 Backlit。隱藏菜單欄圖標前會先恢復 Dock 圖標。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ Backlit อยู่ในแถบเมนู เมื่อซ่อนไอคอนแถบเมนู จะแสดงไอคอน Dock กลับมาก่อน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni Backlit nella barra dei menu. Nascondendo l’icona nella barra dei menu viene prima ripristinata quella del Dock."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd Backlit in de menubalk. Als je het menubalksymbool verbergt, wordt eerst het Dock-symbool teruggezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw Backlit na pasku menu. Ukrycie ikony paska menu najpierw przywróci ikonę w Docku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit’i menü çubuğunda tutun. Menü çubuğu simgesi gizlendiğinde önce Dock simgesi geri gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Backlit trên thanh menu. Khi ẩn biểu tượng thanh menu, biểu tượng Dock sẽ hiện lại trước."
          }
        },
