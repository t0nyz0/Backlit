    "The current key stops working immediately. Home Assistant will ask for the new key before it can control the light again.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current key stops working immediately. Home Assistant will ask for the new key before it can control the light again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave actual dejará de funcionar inmediatamente. Home Assistant pedirá la nueva clave antes de poder controlar la luz de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé actuelle cesse immédiatement de fonctionner. Home Assistant demandera la nouvelle clé avant de pouvoir contrôler à nouveau la lumière."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Schlüssel funktioniert sofort nicht mehr. Home Assistant benötigt den neuen Schlüssel, bevor es das Licht wieder steuern kann."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のキーは直ちに無効になります。Home Assistantで再びライトを制御するには、新しいキーの入力が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 키는 즉시 작동을 멈춥니다. Home Assistant가 조명을 다시 제어하려면 새 키를 입력해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave atual para de funcionar imediatamente. O Home Assistant pedirá a nova chave antes de poder controlar a luz novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前密钥将立即失效。Home Assistant 需要新密钥才能再次控制灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前金鑰將立即失效。Home Assistant 需要新金鑰才能再次控制燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ปัจจุบันจะใช้ไม่ได้ทันที Home Assistant จะขอคีย์ใหม่ก่อนควบคุมไฟได้อีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave attuale smette subito di funzionare. Home Assistant chiederà la nuova chiave prima di poter controllare di nuovo la luce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige sleutel stopt meteen met werken. Home Assistant vraagt om de nieuwe sleutel voordat het het licht weer kan bedienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżący klucz od razu przestanie działać. Aby ponownie sterować podświetleniem, Home Assistant poprosi o nowy klucz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli anahtar hemen geçersiz olur. Home Assistant, ışığı yeniden denetlemeden önce yeni anahtarı ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa hiện tại sẽ mất hiệu lực ngay. Home Assistant sẽ yêu cầu khóa mới trước khi điều khiển lại đèn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci saat ini langsung berhenti berlaku. Home Assistant akan meminta kunci baru sebelum dapat mengendalikan lampu lagi."
          }
        }
      }
    },
