    "Control your light on request, or reflect coding activity automatically.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control your light on request, or reflect coding activity automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla la luz cuando lo pidas o refleja automáticamente la actividad de programación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez votre lumière à la demande ou reflétez automatiquement l’activité de programmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht auf Wunsch steuern oder Programmieraktivität automatisch anzeigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指示に応じてライトを操作するか、コーディング状況を自動で反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청할 때 조명을 제어하거나 코딩 활동을 자동으로 반영합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle a luz quando solicitar ou reflita automaticamente a atividade de programação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需控制灯光，或自动反映编程活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依要求控制燈光，或自動反映程式工作狀態。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมไฟเมื่อร้องขอ หรือแสดงกิจกรรมเขียนโค้ดโดยอัตโนมัติ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
