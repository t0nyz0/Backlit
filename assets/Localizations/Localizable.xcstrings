            "value": "Usługa logo nie potwierdziła żądanej jasności."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo servisi istenen parlaklığı doğrulamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ đèn logo không xác nhận mức sáng đã yêu cầu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan logo tidak mengonfirmasi kecerahan yang diminta."
          }
        }
      }
    },
    "The logo service has not reconnected after changing ambient limits. Restore Light before retrying.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo service has not reconnected after changing ambient limits. Restore Light before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio del logo no se ha reconectado tras cambiar los límites ambientales. Usa Restaurar luz antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service du logo ne s’est pas reconnecté après la modification des limites ambiantes. Utilisez Restaurer la lumière avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Logodienst hat sich nach dem Ändern der Umgebungslichtgrenzen nicht erneut verbunden. Stellen Sie vor einem neuen Versuch das Licht wieder her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境光の制限を変更した後、ロゴサービスに再接続できていません。再試行の前にライトを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변광 제한을 변경한 후 로고 서비스가 다시 연결되지 않았습니다. 다시 시도하기 전에 조명을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço do logo não reconectou após a alteração dos limites de luz ambiente. Use Restaurar luz antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改环境光限制后，徽标服务尚未重新连接。重试前请恢复灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改環境光限制後，標誌服務尚未重新連接。重試前請恢復燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการโลโก้ยังไม่เชื่อมต่อใหม่หลังเปลี่ยนขีดจำกัดแสงแวดล้อม กู้คืนไฟก่อนลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio del logo non si è riconnesso dopo la modifica dei limiti ambientali. Seleziona «Ripristina luce» prima di riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De logoservice heeft na wijziging van de omgevingslimieten nog geen verbinding gemaakt. Kies ‘Licht herstellen’ voordat je het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa logo nie połączyła się ponownie po zmianie limitów oświetlenia otoczenia. Przed ponowną próbą wybierz „Przywróć podświetlenie”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortam sınırları değiştikten sonra logo servisi yeniden bağlanmadı. Tekrar denemeden önce “Işığı Geri Yükle”yi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ đèn logo chưa kết nối lại sau khi đổi giới hạn theo ánh sáng môi trường. Chọn Khôi phục đèn trước khi thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan logo belum tersambung kembali setelah batas cahaya sekitar diubah. Pilih Pulihkan Lampu sebelum mencoba lagi."
          }
        }
      }
    },
    "The logo's off state could not be verified. Fade recovery is retained.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
