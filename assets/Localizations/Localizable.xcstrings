    "Experimental filter active. Test Shift + brightness on your keyboard; screen suppression is not yet verified.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental filter active. Test Shift + brightness on your keyboard; screen suppression is not yet verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtro experimental activo. Prueba Shift + brillo en tu teclado; aún no se ha verificado que no cambie el brillo de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre expérimental actif. Testez Maj + luminosité sur votre clavier ; le blocage du changement de luminosité de l’écran n’est pas encore vérifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenteller Filter aktiv. Shift + Helligkeitstaste testen; die Unterdrückung der Bildschirmänderung ist noch nicht bestätigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的なフィルタが有効です。キーボードでShift + 明るさキーを試してください。画面への影響の抑制は未確認です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적 필터가 활성화되었습니다. 키보드에서 Shift + 밝기 키를 시험하세요. 화면 밝기 변경 억제는 아직 확인되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtro experimental ativo. Teste Shift + brilho no teclado; ainda não foi verificado se o brilho da tela permanece inalterado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验过滤器已启用。请测试键盘上的 Shift + 亮度键；尚未确认能阻止屏幕亮度变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗過濾器已啓用。請測試鍵盤上的 Shift + 亮度鍵；尚未確認能阻止螢幕亮度變化。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตัวกรองทดลองแล้ว ลอง Shift + ปุ่มความสว่างบนแป้นพิมพ์ ยังไม่ได้ยืนยันการป้องกันไม่ให้หน้าจอเปลี่ยนตาม"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtro sperimentale attivo. Prova Maiuscole + luminosità sulla tastiera: non è ancora verificato che la luminosità dello schermo resti invariata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenteel filter actief. Test Shift + helderheid op je toetsenbord. Het is nog niet bevestigd dat de schermhelderheid gelijk blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr eksperymentalny jest aktywny. Wypróbuj Shift + klawisz jasności na klawiaturze. Nie zweryfikowano jeszcze, czy jasność ekranu pozostaje bez zmian."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneysel filtre etkin. Klavyenizde Shift + parlaklık tuşunu deneyin. Ekran parlaklığının değişmediği henüz doğrulanmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ lọc thử nghiệm đang hoạt động. Hãy thử Shift + phím độ sáng trên bàn phím; chưa xác minh được rằng màn hình sẽ không đổi độ sáng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter eksperimental aktif. Uji Shift + tombol kecerahan pada papan ketik; belum dipastikan apakah perubahan layar berhasil dicegah."
          }
        }
      }
    },
