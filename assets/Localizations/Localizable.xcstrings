    "Active. Safety limits still apply.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active. Safety limits still apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activo. Los límites de seguridad siguen vigentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif. Les limites de sécurité restent applicables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv. Sicherheitsgrenzen gelten weiterhin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作中です。安全上の制限は引き続き適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 상태입니다. 안전 제한은 계속 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
