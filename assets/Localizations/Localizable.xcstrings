        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段中繼資料不完整，此快照可能缺少部分程式工作階段。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมตาดาทาเซสชันไม่ครบ ข้อมูลที่เก็บครั้งนี้อาจขาดเซสชันเขียนโค้ดบางรายการ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I metadati delle sessioni sono incompleti. Alcune sessioni di programmazione potrebbero mancare da questa istantanea."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sessiemetadata zijn onvolledig. Sommige programmeersessies ontbreken mogelijk in dit overzicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadane sesji są niepełne. W tym widoku mogą nie być widoczne wszystkie sesje programowania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum üst verileri eksik. Bu görünümde bazı kodlama oturumları eksik olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin phiên không đầy đủ. Bản ghi này có thể thiếu một số phiên lập trình."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata sesi tidak lengkap. Beberapa sesi pemrograman mungkin tidak tercantum dalam cuplikan ini."
          }
        }
      }
    },
