        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logonun kapalı olduğu doğrulanamadı. Sönümleme kurtarma bilgileri saklandı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác minh được trạng thái tắt của đèn logo. Thông tin khôi phục hiệu ứng chuyển sáng vẫn được giữ lại."
          }
