    "Turn off closed-lid lighting and finish its cleanup before changing ambient limits.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off closed-lid lighting and finish its cleanup before changing ambient limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la luz con tapa cerrada y termina su limpieza antes de cambiar los límites ambientales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez l’éclairage capot fermé et terminez son nettoyage avant de modifier les limites ambiantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelbeleuchtung ausschalten und die Bereinigung abschließen, bevor die Umgebungslichtgrenzen geändert werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境光の制限を変更する前に、画面を閉じた状態の点灯をオフにして後処理を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변광 제한을 변경하기 전에 덮개 닫힘 조명을 끄고 정리를 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a luz com a tampa fechada e conclua a limpeza antes de alterar os limites de luz ambiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改环境光限制前，请关闭合盖灯光并完成清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改環境光限制前，請關閉合蓋燈光並完成清理。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดไฟเมื่อปิดฝาจอและล้างสถานะให้เสร็จก่อนเปลี่ยนขีดจำกัดแสงแวดล้อม"
          }
        }
      }
    },
    "Turn off the closed-lid session and let cleanup finish before changing its duration.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the closed-lid session and let cleanup finish before changing its duration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la sesión con la tapa cerrada y espera a que termine la restauración antes de cambiar su duración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez la session capot fermé et attendez la fin du nettoyage avant de modifier sa durée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelsitzung ausschalten und die Bereinigung abschließen lassen, bevor Sie die Dauer ändern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を変更する前に、閉じた画面での点灯をオフにして後処理が完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 변경하기 전에 덮개를 닫은 상태의 세션을 끄고 정리가 끝날 때까지 기다리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative a sessão com a tampa fechada e aguarde a conclusão da limpeza antes de alterar sua duração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改持续时间前，请关闭合盖会话并等待清理完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先關閉闔蓋功能並等待還原完成，再更改持續時間。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดเซสชันเมื่อปิดฝาจอและรอให้การล้างสถานะเสร็จก่อนเปลี่ยนระยะเวลา"
          }
        }
      }
    },
