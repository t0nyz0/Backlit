    "macOS could not show the Dock icon. Backlit will keep its menu bar entry available.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not show the Dock icon. Backlit will keep its menu bar entry available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo mostrar el icono del Dock. Backlit mantendrá disponible su entrada en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas pu afficher l’icône du Dock. Backlit conservera son entrée dans la barre des menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte das Dock-Symbol nicht anzeigen. Backlit bleibt in der Menüleiste verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでDockアイコンを表示できませんでした。Backlitのメニューバー項目は引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 Dock 아이콘을 표시하지 못했습니다. Backlit은 메뉴 막대 항목을 계속 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não conseguiu mostrar o ícone do Dock. O Backlit manterá sua entrada na barra de menus disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法显示 Dock 图标。Backlit 将继续保留菜单栏入口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 無法顯示 Dock 圖標。Backlit 將繼續保留菜單欄入口。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS แสดงไอคอน Dock ไม่ได้ Backlit จะคงรายการในแถบเมนูไว้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non è riuscito a mostrare l’icona del Dock. Backlit manterrà accessibile la voce nella barra dei menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kon het Dock-symbool niet tonen. Backlit blijft beschikbaar in de menubalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nie mógł pokazać ikony w Docku. Ikona Backlit pozostanie dostępna na pasku menu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Dock simgesini gösteremedi. Backlit’in menü çubuğu simgesi kullanılabilir kalacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS không hiển thị được biểu tượng Dock. Backlit sẽ giữ mục trên thanh menu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tidak dapat menampilkan ikon Dock. Backlit akan tetap tersedia di bar menu."
          }
        }
      }
    },
    "macOS did not allow the brightness-key filter. Review Accessibility and Input Monitoring, or use the regular shortcuts.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS did not allow the brightness-key filter. Review Accessibility and Input Monitoring, or use the regular shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no permitió el filtro de teclas de brillo. Revisa Accesibilidad y Monitorización de entrada, o usa los atajos normales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas autorisé le filtre des touches de luminosité. Vérifiez Accessibilité et Surveillance de l’entrée, ou utilisez les raccourcis habituels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Helligkeitstastenfilter nicht erlaubt. Prüfen Sie Bedienungshilfen und Eingabeüberwachung oder verwenden Sie normale Kurzbefehle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSが明るさキーのフィルタを許可しませんでした。アクセシビリティと入力監視の設定を確認するか、通常のショートカットを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 밝기 키 필터를 허용하지 않았습니다. 손쉬운 사용 및 입력 모니터링 설정을 확인하거나 일반 단축키를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não permitiu o filtro de teclas de brilho. Revise Acessibilidade e Monitoramento de Entrada ou use os atalhos comuns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未允许亮度键过滤器。请检查“辅助功能”和“输入监控”，或使用普通快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未允許亮度鍵篩選器。請檢查「輔助使用」和「輸入監控」，或使用一般快捷鍵。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ไม่อนุญาตตัวกรองปุ่มความสว่าง ตรวจการช่วยการเข้าถึงและการตรวจดูอินพุต หรือใช้ปุ่มลัดทั่วไป"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non ha consentito il filtro dei tasti di luminosità. Controlla Accessibilità e Monitoraggio input oppure usa le normali abbreviazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS stond het filter voor helderheidstoetsen niet toe. Controleer Toegankelijkheid en Invoercontrole of gebruik gewone toetscombinaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nie zezwolił na działanie filtra klawiszy jasności. Sprawdź uprawnienia Dostępność i Monitorowanie wprowadzania lub użyj zwykłych skrótów."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, parlaklık tuşu filtresine izin vermedi. Erişilebilirlik ve Girdi İzleme ayarlarını gözden geçirin veya normal kestirmeleri kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS không cho phép dùng bộ lọc phím độ sáng. Kiểm tra Trợ năng và Giám sát đầu vào hoặc dùng phím tắt thông thường."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tidak mengizinkan filter tombol kecerahan. Tinjau Aksesibilitas dan Pemantauan Input, atau gunakan pintasan biasa."
          }
        }
      }
    },
