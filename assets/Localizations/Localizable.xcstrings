            "value": "Önceki ışık temizliği doğrulandı. Otomatik olarak yeniden bağlanılıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xác minh dọn dẹp phiên đèn trước. Đang tự kết nối lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan sesi lampu sebelumnya terverifikasi. Menyambungkan kembali secara otomatis."
          }
        }
      }
    },
