            "state": "translated",
            "value": "Backlit ya se está ejecutando en otra ventana. Usa la copia instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit est déjà ouvert dans une autre fenêtre. Utilisez la copie installée."
          }
        },
