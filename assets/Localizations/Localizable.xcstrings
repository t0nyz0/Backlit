            "state": "translated",
            "value": "The logo's off state could not be verified. Fade recovery is retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar que el logo estuviera apagado. Se conserva la información de recuperación de la transición de brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
