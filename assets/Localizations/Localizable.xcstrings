    "Light or lid recovery remains unconfirmed. Recovery was retained.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light or lid recovery remains unconfirmed. Recovery was retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación de la luz o de la tapa sigue sin confirmarse. Se conservó la información de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration de la lumière ou du capot reste non confirmée. Les données de restauration ont été conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung von Licht oder Deckel bleibt unbestätigt. Die Wiederherstellungsdaten bleiben erhalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトまたは画面開閉状態の復元は未確認です。復元情報は保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명 또는 덮개 복구가 아직 확인되지 않았습니다. 복구 정보는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação da luz ou da tampa continua sem confirmação. Os dados de recuperação foram preservados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光或上盖恢复仍未确认，已保留恢复数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光或上蓋恢復仍未確認，已保留恢複數據。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังยืนยันการกู้คืนไฟหรือฝาจอไม่ได้ โดยคงข้อมูลกู้คืนไว้"
