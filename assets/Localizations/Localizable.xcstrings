    "Safety state changed during verification. Backlit will check again before reconnecting.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety state changed during verification. Backlit will check again before reconnecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de seguridad cambió durante la verificación. Backlit volverá a comprobarlo antes de reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de sécurité a changé pendant la vérification. Backlit le vérifiera à nouveau avant de se reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsstatus hat sich während der Prüfung geändert. Backlit prüft vor der Neuverbindung erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中に安全状態が変化しました。Backlitは再接続の前に再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 중 안전 상태가 변경되었습니다. Backlit은 다시 연결하기 전에 재확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado de segurança mudou durante a verificação. O Backlit verificará novamente antes de reconectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证期间安全状态发生变化。Backlit 将在重新连接前再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證期間安全狀態發生變化。Backlit 將在重新連接前再次檢查。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะความปลอดภัยเปลี่ยนระหว่างตรวจสอบ Backlit จะตรวจอีกครั้งก่อนเชื่อมต่อใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato di sicurezza è cambiato durante la verifica. Backlit eseguirà un nuovo controllo prima di riconnettersi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De veiligheidsstatus is tijdens de verificatie gewijzigd. Backlit controleert deze opnieuw voordat het weer verbinding maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan zabezpieczeń zmienił się w trakcie sprawdzania. Backlit sprawdzi go ponownie przed ponownym połączeniem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama sırasında güvenlik durumu değişti. Backlit yeniden bağlanmadan önce tekrar denetleyecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái an toàn đã đổi trong khi xác minh. Backlit sẽ kiểm tra lại trước khi kết nối lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status keselamatan berubah selama verifikasi. Backlit akan memeriksa lagi sebelum menyambungkan kembali."
          }
        }
      }
    },
    "Safety verification failed: {detail} Restore your light before retrying.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged. Preserve {detail} verbatim: arbitrary diagnostic content; never parse or translate it.",
