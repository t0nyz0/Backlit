    "Normal lid sleep was restored. A leftover session file could not be removed.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal lid sleep was restored. A leftover session file could not be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauró el reposo normal al cerrar la tapa. No se pudo eliminar un archivo de sesión residual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en veille normale à la fermeture du capot a été rétablie. Un fichier de session résiduel n’a pas pu être supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normaler Ruhezustand beim Schließen wiederhergestellt. Eine verbliebene Sitzungsdatei konnte nicht entfernt werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を閉じたときの通常のスリープ動作を復元しました。残っているセッションファイルを削除できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫을 때의 일반 잠자기 동작을 복원했습니다. 남은 세션 파일은 제거하지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repouso normal ao fechar a tampa foi restaurado. Não foi possível remover um arquivo de sessão restante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复正常的合盖睡眠，但无法移除残留的会话文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢復正常的合蓋睡眠，但無法移除殘留的會話檔案。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนค่าการพักเครื่องตามปกติเมื่อปิดฝาจอแล้ว แต่ลบไฟล์เซสชันที่ค้างไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sospensione alla chiusura del coperchio è stata ripristinata. Impossibile rimuovere un file residuo della sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De normale sluimerstand bij sluiten is hersteld. Een achtergebleven sessiebestand kon niet worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócono zwykłe usypianie po zamknięciu pokrywy. Nie udało się usunąć pliku pozostałego po sesji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapanınca normal uyku davranışı geri yüklendi. Oturumdan kalan bir dosya kaldırılamadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục chế độ ngủ bình thường khi đóng nắp. Không xóa được một tệp phiên còn sót lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode tidur normal saat penutup ditutup telah dipulihkan. Berkas sesi yang tersisa tidak dapat dihapus."
          }
        }
      }
    },
