        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha interrotto il controllo dei tasti hardware. I tasti di luminosità sono nuovamente gestiti da macOS; usa le normali abbreviazioni o riattiva l’opzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft de hardwaretoetsbediening gestopt. De helderheidstoetsen worden weer beheerd door macOS. Gebruik gewone toetscombinaties of schakel de optie opnieuw in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zatrzymał sterowanie klawiszami sprzętowymi. Klawisze jasności znów obsługuje macOS. Użyj zwykłych skrótów albo ponownie włącz tę opcję."
          }
