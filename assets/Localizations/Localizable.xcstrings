          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação automática não controla mais a sessão de transição de brilho registrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动恢复已不再拥有记录的渐变会话控制权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動恢復已不再擁有記錄的漸變會話控制權。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกู้คืนอัตโนมัติไม่มีสิทธิ์ควบคุมเซสชันเฟดที่บันทึกไว้อีกต่อไป"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino automatico non controlla più la sessione di dissolvenza registrata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch herstel beheert de opgeslagen fadesessie niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisana sesja wygaszania nie jest już pod kontrolą automatycznego odzyskiwania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik kurtarma artık kaydedilen sönümleme oturumunu denetlemiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng khôi phục tự động không còn kiểm soát phiên chuyển sáng đã ghi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan otomatis tidak lagi mengendalikan sesi peredupan yang tercatat."
          }
        }
      }
    },
