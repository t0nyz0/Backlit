    "Default: automatic charging pulse, 6-second cycle, dims to 0%, charge-ready signal off.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: automatic charging pulse, 6-second cycle, dims to 0%, charge-ready signal off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto: pulso de carga automático, ciclo de 6 segundos, atenuación al 0% y señal de carga alcanzada desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut : pulsation automatique pendant la charge, cycle de 6 secondes, atténuation à 0 % et signal de charge atteinte désactivé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard: automatischer Ladepuls, 6-Sekunden-Zyklus, Abdunkeln auf 0 %, Ladeziel-Signal aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト：充電中に自動点滅、周期6秒、最低輝度0%、充電目標の合図はオフ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값: 충전 중 자동 맥박, 6초 주기, 최소 밝기 0%, 충전 목표 신호 끔."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrão: pulsação automática ao carregar, ciclo de 6 segundos, redução até 0% e sinal de carga atingida desativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认：充电时自动脉动，周期 6 秒，最低亮度 0%，关闭充电达标提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設：充電時自動脈動，週期 6 秒，最低亮度 0%，關閉充電達標提示。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้น: จังหวะชาร์จอัตโนมัติ รอบ 6 วินาที หรี่ถึง 0% และปิดสัญญาณชาร์จถึงเป้าหมาย"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: impulso automatico in carica, ciclo di 6 secondi, luminosità minima 0%, segnale di carica raggiunta disattivato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard: automatische laadpuls, cyclus van 6 seconden, dimt tot 0%, laadsignaal uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie: automatyczne pulsowanie podczas ładowania, cykl 6 sekund, przyciemnianie do 0%, sygnał naładowania wyłączony."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saptanmış ayar: Şarj sırasında otomatik atım, 6 saniyelik döngü, %0’a kadar kısma. Şarj eşiği sinyali kapalı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định: tự sáng theo nhịp khi sạc, chu kỳ 6 giây, giảm xuống 0%, tắt tín hiệu pin đạt ngưỡng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawaan: denyut otomatis saat mengisi daya, siklus 6 detik, redup hingga 0%, dan sinyal daya siap mati."
          }
        }
      }
    },
