          "stringUnit": {
            "state": "translated",
            "value": "Bezig met opruimen. Je keuze is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa porządkowanie. Twój wybór został zapamiętany."
