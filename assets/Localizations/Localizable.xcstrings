          }
        }
      }
    },
    "Turn off the closed-lid session and let cleanup finish before changing its duration.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the closed-lid session and let cleanup finish before changing its duration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva la sesión con la tapa cerrada y espera a que termine la restauración antes de cambiar su duración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez la session capot fermé et attendez la fin du nettoyage avant de modifier sa durée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
