    "The AI connection key was replaced. Turn AI access off to stop all assistant connections.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI connection key was replaced. Turn AI access off to stop all assistant connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazó la clave de conexión de IA. Desactiva el acceso de IA para detener todas las conexiones de asistentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de connexion IA a été remplacée. Désactivez l’accès IA pour arrêter toutes les connexions d’assistants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Verbindungsschlüssel ersetzt. KI-Zugriff ausschalten, um alle Assistentenverbindungen zu beenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI接続キーを交換しました。すべてのアシスタント接続を停止するにはAIアクセスをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 연결 키를 교체했습니다. 모든 어시스턴트 연결을 중단하려면 AI 접근을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de conexão de IA foi substituída. Desative o acesso de IA para encerrar todas as conexões de assistentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已更换 AI 连接密钥。关闭 AI 访问可停止所有助手连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已更換 AI 連接金鑰。關閉 AI 訪問可停止所有助手連接。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนคีย์การเชื่อมต่อ AI แล้ว ปิดการเข้าถึง AI เพื่อหยุดการเชื่อมต่อผู้ช่วยทั้งหมด"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di connessione all’IA è stata sostituita. Disattiva l’accesso all’IA per interrompere tutte le connessioni degli assistenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel voor AI-verbindingen is vervangen. Schakel AI-toegang uit om alle assistentverbindingen te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymieniono klucz połączenia AI. Wyłącz dostęp AI, aby przerwać wszystkie połączenia asystentów."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ bağlantı anahtarı değiştirildi. Tüm asistan bağlantılarını durdurmak için yapay zekâ erişimini kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thay khóa kết nối AI. Tắt quyền truy cập AI để dừng mọi kết nối của trợ lý."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci koneksi AI telah diganti. Matikan akses AI untuk menghentikan semua koneksi asisten."
          }
        }
      }
    },
    "The MCP connection was switched off because its Keychain key is unavailable. Enable it again in Connections.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
