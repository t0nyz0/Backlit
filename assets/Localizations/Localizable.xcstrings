          "stringUnit": {
            "state": "translated",
            "value": "デフォルト：充電中に自動点滅、周期6秒、最低輝度0%、充電目標の合図はオフ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값: 충전 중 자동 맥박, 6초 주기, 최소 밝기 0%, 충전 목표 신호 끔."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
