    "Pulses only while actively charging, then stays solid when charging pauses or finishes.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulses only while actively charging, then stays solid when charging pauses or finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emite pulsos solo mientras carga activamente; después mantiene la luz fija cuando la carga se pausa o termina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse uniquement pendant la charge active, puis reste fixe lorsque la charge est suspendue ou terminée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsiert nur beim aktiven Laden und leuchtet konstant, wenn das Laden pausiert oder endet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電中だけゆっくり点滅し、充電が一時停止または完了すると点灯し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 충전 중일 때만 맥박처럼 빛나며 충전이 일시 중지되거나 끝나면 계속 켜집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa somente durante a carga ativa e mantém a luz constante quando a carga pausa ou termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在正在充电时脉动，充电暂停或完成后保持常亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在正在充電時脈動，充電暫停或完成後保持常亮。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สว่างเป็นจังหวะเฉพาะตอนกำลังชาร์จ แล้วสว่างค้างเมื่อการชาร์จพักหรือเสร็จสิ้น"
          }
        }
      }
    },
