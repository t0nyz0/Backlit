            "state": "translated",
            "value": "The closed-lid recovery choice could not be saved. Restore your light before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la elección de recuperación con tapa cerrada. Restaura la luz antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le choix de restauration capot fermé. Restaurez la lumière avant de réessayer."
