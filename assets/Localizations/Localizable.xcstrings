    "Pairing key copied. Paste it into Home Assistant; keep it private.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing key copied. Paste it into Home Assistant; keep it private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de emparejamiento copiada. Pégala en Home Assistant y mantenla privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé d’appairage copiée. Collez-la dans Home Assistant et gardez-la privée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplungsschlüssel kopiert. In Home Assistant einfügen und geheim halten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングキーをコピーしました。Home Assistantに貼り付け、他人に知られないようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 키를 복사했습니다. Home Assistant에 붙여넣고 비공개로 보관하세요."
          }
        },
        "pt-BR": {
