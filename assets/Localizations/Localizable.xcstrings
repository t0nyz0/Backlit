    "Automatic light recovery stopped after three attempts. Restore Light before retrying.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic light recovery stopped after three attempts. Restore Light before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación automática de la luz se detuvo tras tres intentos. Usa Restaurar luz antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration automatique de la lumière s’est arrêtée après trois tentatives. Utilisez Restaurer la lumière avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Lichtwiederherstellung wurde nach drei Versuchen gestoppt. Stellen Sie vor einem neuen Versuch das Licht wieder her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトの自動復元は3回の試行後に停止しました。再試行の前にライトを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 조명 복구가 세 번 시도 후 중단되었습니다. 다시 시도하기 전에 조명을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação automática da luz parou após três tentativas. Use Restaurar luz antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动灯光恢复已在三次尝试后停止。重试前请恢复灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動燈光恢復已在三次嘗試後停止。重試前請恢復燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกู้คืนไฟอัตโนมัติหยุดหลังลองสามครั้ง กู้คืนไฟก่อนลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino automatico della luce si è interrotto dopo tre tentativi. Seleziona «Ripristina luce» prima di riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch lichtherstel is na drie pogingen gestopt. Kies ‘Licht herstellen’ voordat je het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne odzyskiwanie podświetlenia zatrzymało się po trzech próbach. Przed kolejną próbą wybierz „Przywróć podświetlenie”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik ışık kurtarma üç denemeden sonra durdu. Tekrar denemeden önce “Işığı Geri Yükle”yi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động khôi phục đèn đã dừng sau ba lần thử. Chọn Khôi phục đèn trước khi thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan lampu otomatis berhenti setelah tiga percobaan. Pilih Pulihkan Lampu sebelum mencoba lagi."
          }
        }
      }
    },
