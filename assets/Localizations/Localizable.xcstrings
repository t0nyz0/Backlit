        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명이 켜져 있고 Mac이 활성 상태일 때 음악 모드와 함께 시스템 오디오가 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio do sistema inicia com Música quando a luz está acesa e o Mac está ativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音乐模式下，当灯光开启且 Mac 处于活动状态时启动系统音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音樂模式下，當燈光開啓且 Mac 處於活動狀態時啓動系統音訊。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงระบบเริ่มพร้อมโหมดเพลงเมื่อไฟเปิดและ Mac กำลังใช้งาน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio di sistema si avvia in modalità Musica quando la luce è accesa e il Mac è attivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemgeluid start in de muziekmodus als je licht aan is en je Mac actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk systemowy włącza się w trybie Muzyka, gdy podświetlenie jest włączone, a Mac aktywny."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işık yanarken ve Mac etkin durumdayken sistem sesi Müzik moduyla birlikte başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh hệ thống khởi động cùng chế độ Nhạc khi đèn bật và máy Mac đang hoạt động."
