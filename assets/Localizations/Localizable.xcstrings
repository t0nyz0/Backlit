    "Use Command, Control or Option with a regular key. Shift alone and hardware brightness keys are not supported.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Command, Control or Option with a regular key. Shift alone and hardware brightness keys are not supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Command, Control u Option con una tecla normal. No se admite Shift solo ni las teclas físicas de brillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Command, Control ou Option avec une touche standard. Maj seule et les touches physiques de luminosité ne sont pas prises en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Command, Control oder Option zusammen mit einer normalen Taste. Shift allein und Hardware-Helligkeitstasten werden nicht unterstützt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command、Control、Optionのいずれかと通常のキーを組み合わせてください。Shiftだけの組み合わせとハードウェアの明るさキーには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, Control 또는 Option과 일반 키를 함께 사용하세요. Shift만 사용하거나 하드웨어 밝기 키를 사용하는 조합은 지원되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Command, Control ou Option junto com uma tecla comum. Shift sozinho e teclas físicas de brilho não são compatíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 Command、Control 或 Option 加普通按键。不支持单独使用 Shift 或硬件亮度键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 Command、Control 或 Option 加普通按鍵。不支持單獨使用 Shift 或硬體亮度鍵。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Command, Control หรือ Option กับปุ่มทั่วไป ไม่รองรับ Shift เพียงอย่างเดียวและปุ่มความสว่างฮาร์ดแวร์"
          }
        }
      }
    },
