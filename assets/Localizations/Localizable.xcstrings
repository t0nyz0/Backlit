    "Closed-lid lighting paused after an error": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid lighting paused after an error"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz con tapa cerrada pausada tras un error"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairage capot fermé suspendu après une erreur"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelbeleuchtung nach einem Fehler pausiert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーにより画面を閉じた状態の点灯を一時停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류로 덮개 닫힘 조명이 일시 중지됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz com tampa fechada pausada após um erro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖灯光因错误而暂停"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合蓋燈光因錯誤而暫停"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟเมื่อปิดฝาจอหยุดชั่วคราวหลังเกิดข้อผิดพลาด"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Illuminazione a coperchio chiuso sospesa dopo un errore"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Licht bij gesloten deksel gepauzeerd na een fout"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podświetlanie przy zamkniętej pokrywie wstrzymane po błędzie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalıyken aydınlatma bir hatadan sonra duraklatıldı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đèn khi đóng nắp tạm dừng do lỗi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu saat penutup tertutup dijeda setelah terjadi kesalahan"
          }
        }
      }
    },
    "Closed-lid lighting paused after an error, so the logo is off. Restore your light in Settings, then turn “Keep logo on with lid closed” off and on to retry.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid lighting paused after an error, so the logo is off. Restore your light in Settings, then turn “Keep logo on with lid closed” off and on to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz con tapa cerrada se pausó tras un error, por lo que el logo está apagado. Restaura la luz en Ajustes y luego desactiva y vuelve a activar «Mantener el logo encendido con la tapa cerrada» para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’éclairage capot fermé a été suspendu après une erreur ; le logo est donc éteint. Restaurez la lumière dans Réglages, puis désactivez et réactivez « Garder le logo allumé avec le capot fermé » pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelbeleuchtung nach einem Fehler pausiert; das Logo ist aus. In den Einstellungen das Licht wiederherstellen, dann „Logo bei geschlossenem Deckel eingeschaltet lassen“ aus- und einschalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーにより画面を閉じた状態の点灯が一時停止し、ロゴは消灯しています。設定でライトを復元し、「画面を閉じてもロゴを点灯」をオフにしてからオンにして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류로 덮개 닫힘 조명이 일시 중지되어 로고가 꺼져 있습니다. 설정에서 조명을 복원한 다음 ‘덮개를 닫아도 로고 켜기’를 껐다 켜서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz com a tampa fechada foi pausada após um erro, então o logo está apagado. Restaure a luz em Ajustes e depois desative e reative “Manter logo aceso com a tampa fechada” para tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖灯光因错误而暂停，因此徽标已熄灭。请在设置中恢复灯光，然后关闭并重新开启“合盖时保持徽标亮起”以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合蓋燈光因錯誤而暫停，因此徽標已熄滅。請在設定中恢復燈光，然後關閉並重新開啓“合蓋時保持徽標亮起”以重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟเมื่อปิดฝาจอหยุดชั่วคราวหลังเกิดข้อผิดพลาด โลโก้จึงดับ กู้คืนไฟในการตั้งค่า แล้วปิดและเปิด “เปิดโลโก้ค้างไว้เมื่อปิดฝาจอ” เพื่อลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’illuminazione a coperchio chiuso è stata sospesa dopo un errore e il logo è spento. Ripristina la luce in Impostazioni, poi disattiva e riattiva «Mantieni acceso il logo a coperchio chiuso» per riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het licht bij gesloten deksel is na een fout gepauzeerd. Het logo is uit. Herstel je licht in Instellingen en schakel daarna ‘Houd logo aan bij gesloten deksel’ uit en weer in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po błędzie wstrzymano podświetlanie przy zamkniętej pokrywie, więc logo jest wyłączone. Przywróć podświetlenie w ustawieniach, a następnie wyłącz i ponownie włącz opcję „Podświetlaj logo przy zamkniętej pokrywie”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hatadan sonra kapak kapalıyken aydınlatma duraklatıldı, bu yüzden logo kapalı. Işığı Ayarlar’da geri yükleyin, ardından “Kapak kapalıyken logoyu açık tut” seçeneğini kapatıp açarak tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đèn logo đã tắt vì tính năng chiếu sáng khi đóng nắp gặp lỗi. Hãy khôi phục đèn trong Cài đặt, rồi tắt và bật lại “Giữ đèn logo sáng khi đóng nắp” để thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu saat penutup tertutup dijeda setelah terjadi kesalahan, sehingga logo mati. Pulihkan lampu di Pengaturan, lalu matikan dan nyalakan kembali “Biarkan logo menyala saat penutup tertutup” untuk mencoba lagi."
          }
        }
      }
    },
    "Closed-lid operation is unavailable in isolated preview.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid operation is unavailable in isolated preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación con tapa cerrada no está disponible en la vista previa aislada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fonctionnement capot fermé n’est pas disponible dans l’aperçu isolé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelbetrieb ist in der isolierten Vorschau nicht verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隔離プレビューでは画面を閉じた状態の動作は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격리된 미리보기에서는 덮개 닫힘 동작을 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação com a tampa fechada não está disponível na prévia isolada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔离预览中无法使用合盖功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隔離預覽中無法使用合蓋功能。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้งานเมื่อปิดฝาจอไม่ได้ในตัวอย่างแยกจากระบบจริง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il funzionamento a coperchio chiuso non è disponibile nell’anteprima isolata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik bij gesloten deksel is niet beschikbaar in de geïsoleerde voorvertoning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsługa zamkniętej pokrywy jest niedostępna w izolowanym podglądzie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalıyken çalışma, yalıtılmış önizlemede kullanılamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sử dụng tính năng đóng nắp trong chế độ xem trước cách ly."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengoperasian dengan penutup tertutup tidak tersedia dalam pratinjau terisolasi."
          }
        }
      }
    },
