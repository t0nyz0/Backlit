    "Restoration was requested. Native handback remains unconfirmed, so the saved closed-lid choice stays paused.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoration was requested. Native handback remains unconfirmed, so the saved closed-lid choice stays paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitó la restauración. Sigue sin confirmarse la devolución del control a macOS, por lo que la elección guardada para la tapa cerrada continúa en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration a été demandée. Le retour du contrôle à macOS reste non confirmé ; le choix enregistré pour le capot fermé reste donc en pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung angefordert. Die Rückgabe an macOS bleibt unbestätigt; die gespeicherte Deckelauswahl bleibt pausiert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元を要求しました。システムへの制御返却が未確認のため、保存した閉じた画面での点灯設定は一時停止のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원을 요청했습니다. 시스템으로의 제어 반환이 확인되지 않아 저장된 덮개 닫힘 설정은 일시 중지된 상태입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração foi solicitada. A devolução do controle ao macOS ainda não foi confirmada, então a escolha salva para a tampa fechada continua pausada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求恢复。但尚未确认已交还原生控制权，因此保存的合盖选择继续暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已請求恢復。但尚未確認已交還原生控制權，因此保存的合蓋選擇繼續暫停。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ร้องขอกู้คืนแล้ว แต่ยังยืนยันการคืนการควบคุมให้ระบบไม่ได้ ตัวเลือกเมื่อปิดฝาจอที่บันทึกไว้จึงยังหยุดชั่วคราว"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristino richiesto. La restituzione del controllo a macOS non è confermata, quindi la scelta salvata a coperchio chiuso resta sospesa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel is aangevraagd. Het is nog niet bevestigd dat macOS de bediening terugheeft, dus de opgeslagen keuze voor gesloten deksel blijft gepauzeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zlecono przywrócenie. Nie potwierdzono oddania sterowania systemowi, więc zapisany wybór podświetlania przy zamkniętej pokrywie pozostaje wstrzymany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme istendi. Denetimin macOS’a döndüğü doğrulanmadığı için kayıtlı kapalı kapak seçimi duraklatılmış olarak kalıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã yêu cầu khôi phục. Chưa xác nhận hệ thống đã tiếp quản lại, nên lựa chọn đóng nắp đã lưu vẫn tạm dừng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan telah diminta. Pengembalian kendali ke macOS belum terkonfirmasi, sehingga pilihan tersimpan untuk penutup tertutup tetap dijeda."
          }
        }
      }
    },
