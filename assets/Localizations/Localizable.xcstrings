    "Adapts to playback level. Intensity adjusts the result; your brightness sets its ceiling.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapts to playback level. Intensity adjusts the result; your brightness sets its ceiling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adapta al volumen de reproducción. La intensidad ajusta la respuesta; el brillo fija su límite máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’adapte au niveau sonore. L’intensité ajuste la réponse ; votre luminosité fixe son plafond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt sich dem Wiedergabepegel an. Die Intensität verändert das Ergebnis; Ihre Helligkeit legt die Obergrenze fest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生音量に合わせて変化します。強度で反応を調整し、明るさ設定が上限になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 음량에 맞춰 조절합니다. 강도는 반응을 조절하고 밝기 설정은 최대 밝기를 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapta-se ao nível do áudio. A intensidade ajusta a resposta; o brilho define o limite máximo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动适应播放音量。强度调整响应效果，您设置的亮度决定上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動適應播放音量。強度調整響應效果，您設定的亮度決定上限。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับตามระดับเสียงที่เล่น ความแรงปรับการตอบสนอง ส่วนความสว่างที่ตั้งไว้เป็นขีดสูงสุด"
          }
        }
      }
    },
    "Agent settings appeared during connection. Nothing was overwritten. Review them and try again.": {
