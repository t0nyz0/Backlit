    "Restore the current logo session before reconnecting its service.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the current logo session before reconnecting its service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura la sesión actual del logo antes de reconectar su servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez la session actuelle du logo avant de reconnecter son service."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie die aktuelle Logositzung wieder her, bevor Sie den Dienst erneut verbinden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスに再接続する前に、現在のロゴセッションを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스를 다시 연결하기 전에 현재 로고 세션을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure a sessão atual do logo antes de reconectar seu serviço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新连接服务前，请恢复当前徽标会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新連接服務前，請恢復當前標誌會話。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนเซสชันโลโก้ปัจจุบันก่อนเชื่อมต่อบริการอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina la sessione attuale del logo prima di riconnettere il servizio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel de huidige logosessie voordat je opnieuw verbinding maakt met de logoservice."
          }
        },
        "pl": {
