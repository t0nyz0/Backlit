        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha verificado la limpieza de la sesión de luz anterior exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la session d’éclairage précédente précise n’est pas vérifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereinigung genau der vorherigen Lichtsitzung ist nicht bestätigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "該当する前回のライトセッションの後処理は確認されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 이전 조명 세션의 정리가 확인되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza da sessão de luz anterior específica não foi verificada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未验证对应的上一灯光会话已完成清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未驗證對應的上一燈光會話已完成清理。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ยืนยันการล้างสถานะของเซสชันไฟก่อนหน้าที่ตรงกัน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino di quella specifica sessione di illuminazione precedente non è verificato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het opruimen van de specifieke vorige lichtsessie is niet bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potwierdzono porządkowania dokładnie tej poprzedniej sesji podświetlenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam olarak önceki ışık oturumunun temizliği doğrulanmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác minh được việc dọn dẹp đúng phiên đèn trước đó."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan sesi lampu sebelumnya yang tercatat belum terverifikasi."
          }
        }
      }
    },
    "The light turns off shortly after typing stops. With the lid closed, use an external keyboard.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light turns off shortly after typing stops. With the lid closed, use an external keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz se apaga poco después de dejar de escribir. Con la tapa cerrada, usa un teclado externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière s’éteint peu après l’arrêt de la saisie. Capot fermé, utilisez un clavier externe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht erlischt kurz nach dem Tippen. Bei geschlossenem Deckel eine externe Tastatur verwenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイピングが止まると、まもなく消灯します。画面を閉じた状態では外付けキーボードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑을 멈추면 잠시 후 조명이 꺼집니다. 덮개를 닫은 상태에서는 외장 키보드를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz apaga logo após você parar de digitar. Com a tampa fechada, use um teclado externo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止打字后灯光很快熄灭。合盖时请使用外接键盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止打字後燈光很快熄滅。合蓋時請使用外接鍵盤。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟจะดับไม่นานหลังหยุดพิมพ์ ใช้แป้นพิมพ์ภายนอกเมื่อปิดฝาจอ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce si spegne poco dopo che smetti di digitare. A coperchio chiuso, usa una tastiera esterna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het licht gaat uit kort nadat je stopt met typen. Gebruik een extern toetsenbord bij gesloten deksel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podświetlenie gaśnie wkrótce po zakończeniu pisania. Przy zamkniętej pokrywie użyj zewnętrznej klawiatury."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma durduktan kısa süre sonra ışık söner. Kapak kapalıyken harici klavye kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đèn sẽ tắt ngay sau khi bạn ngừng gõ. Khi đóng nắp, hãy dùng bàn phím ngoài."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu mati sesaat setelah Anda berhenti mengetik. Gunakan papan ketik eksternal saat penutup tertutup."
          }
        }
      }
    },
