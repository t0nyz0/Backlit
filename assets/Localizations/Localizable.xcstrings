          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De MCP-verbinding is uitgeschakeld omdat de sleutel niet beschikbaar is in Sleutelhanger. Schakel deze opnieuw in bij ‘Verbindingen’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie MCP wyłączono, bo jego klucz w pęku kluczy jest niedostępny. Włącz je ponownie w sekcji Połączenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar Zinciri’ndeki anahtarı kullanılamadığı için MCP bağlantısı kapatıldı. Bağlantılar’da yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối MCP đã tắt vì không lấy được khóa trong Chuỗi khóa. Hãy bật lại trong mục Kết nối."
          }
