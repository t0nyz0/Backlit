        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS đã dừng điều khiển phím phần cứng. Phím độ sáng lại do macOS xử lý; hãy dùng phím tắt thông thường hoặc bật lại tùy chọn."
          }
        },
        "id": {
          "stringUnit": {
