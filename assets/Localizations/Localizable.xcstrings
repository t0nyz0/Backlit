          "stringUnit": {
            "state": "translated",
            "value": "주변광 제한을 변경한 후 로고 서비스가 다시 연결되지 않았습니다. 다시 시도하기 전에 조명을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço do logo não reconectou após a alteração dos limites de luz ambiente. Use Restaurar luz antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改环境光限制后，徽标服务尚未重新连接。重试前请恢复灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改環境光限制後，標誌服務尚未重新連接。重試前請恢復燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการโลโก้ยังไม่เชื่อมต่อใหม่หลังเปลี่ยนขีดจำกัดแสงแวดล้อม กู้คืนไฟก่อนลองใหม่"
