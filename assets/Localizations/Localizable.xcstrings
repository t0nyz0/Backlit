        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook perlu ditinjau · sambungkan kembali atau periksa pengaturan agen"
          }
        }
      }
    },
    "Hooks saved. Review and trust them in Codex Settings → Hooks, then start a new session.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks saved. Review and trust them in Codex Settings → Hooks, then start a new session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks guardados. Revísalos y autorízalos en Codex Settings → Hooks; luego inicia una nueva sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks sauvegardés. Vérifiez-les et approuvez-les dans Codex Settings → Hooks, puis démarrez une nouvelle session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks gespeichert. Unter Codex Settings → Hooks prüfen und als vertrauenswürdig bestätigen, dann eine neue Sitzung starten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックを保存しました。Codex Settings → Hooksで確認して信頼を承認し、新しいセッションを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훅을 저장했습니다. Codex Settings → Hooks에서 검토하고 신뢰한 뒤 새 세션을 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks salvos. Revise-os e autorize-os em Codex Settings → Hooks; depois inicie uma nova sessão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存钩子。请在 Codex Settings → Hooks 中检查并信任它们，然后开始新会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存鈎子。請在 Codex Settings → Hooks 中檢查並信任它們，然後開始新會話。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกฮุกแล้ว ตรวจสอบและอนุมัติความเชื่อถือใน Codex Settings → Hooks แล้วเริ่มเซสชันใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook salvati. Controllali e autorizzali in Impostazioni di Codex → Hooks, poi avvia una nuova sessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks opgeslagen. Controleer en vertrouw ze in Codex-instellingen → Hooks en start een nieuwe sessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano haki. Sprawdź je i oznacz jako zaufane w Codex: Ustawienia → Hooks, a potem rozpocznij nową sesję."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kancalar kaydedildi. Codex Settings → Hooks bölümünde inceleyip güvenilir olarak işaretleyin, sonra yeni bir oturum başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu hook. Hãy xem lại và xác nhận tin cậy trong Cài đặt Codex → Hooks, rồi bắt đầu phiên mới."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook disimpan. Tinjau dan tandai tepercaya di Pengaturan Codex → Hooks, lalu mulai sesi baru."
          }
        }
      }
    },
    "Hooks saved. Review your agent settings, then start a new Claude Code session.": {
