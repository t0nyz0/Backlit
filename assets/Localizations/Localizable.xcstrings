        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria controla o próprio brilho. Escolha um comportamento manual para usar os atalhos de brilho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
