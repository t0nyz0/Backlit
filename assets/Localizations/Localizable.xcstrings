          "stringUnit": {
            "state": "translated",
            "value": "กำลังล้างสถานะ โดยจดจำตัวเลือกของคุณไว้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristino in corso. La scelta è stata salvata."
          }
        },
