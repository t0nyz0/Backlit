    "Home Assistant was switched off because its Keychain key is unavailable. Enable it again in Connections.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant was switched off because its Keychain key is unavailable. Enable it again in Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant se desactivó porque su clave del Llavero no está disponible. Vuelve a activarlo en Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant a été désactivé, car sa clé du trousseau est indisponible. Réactivez-le dans Connexions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant wurde ausgeschaltet, weil sein Schlüssel im Schlüsselbund nicht verfügbar ist. Aktivieren Sie es unter „Verbindungen“ erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンのキーを利用できないため、Home Assistantをオフにしました。「接続」で再度有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인 키를 사용할 수 없어 Home Assistant가 꺼졌습니다. 연결에서 다시 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Home Assistant foi desativado porque sua chave no Chaves está indisponível. Ative-o novamente em Conexões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant 已关闭，因为其钥匙串密钥不可用。请在“连接”中重新启用。"
          }
        },
