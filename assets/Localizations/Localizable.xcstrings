    "Backlit analyzes system playback locally to make your logo respond to music. No audio is recorded or uploaded.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit analyzes system playback locally to make your logo respond to music. No audio is recorded or uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit analiza localmente el audio del sistema para que el logo responda a la música. No se graba ni se sube audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit analyse localement le son du système pour faire réagir le logo à la musique. Aucun son n’est enregistré ni envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit analysiert die Systemwiedergabe lokal, damit Ihr Logo auf Musik reagiert. Es wird kein Audio aufgezeichnet oder hochgeladen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlitはシステムの再生音をこのMac内で解析し、音楽に合わせてロゴを光らせます。音声は録音もアップロードもしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit은 시스템 재생 오디오를 기기에서 분석해 로고가 음악에 반응하게 합니다. 오디오를 녹음하거나 업로드하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Backlit analisa localmente o áudio do sistema para fazer o logo responder à música. Nenhum áudio é gravado ou enviado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 在本机分析系统播放音频，使徽标响应音乐。不会录制或上传音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 在本機分析系統播放音訊，使徽標響應音樂。不會錄制或上傳音訊。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit วิเคราะห์เสียงที่ระบบเล่นภายในเครื่องเพื่อให้โลโก้ตอบสนองต่อเพลง ไม่มีการบันทึกหรืออัปโหลดเสียง"
          }
        }
      }
    },
    "Backlit link copied. Use it with a launcher that supports custom app links.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit link copied. Use it with a launcher that supports custom app links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace de Backlit copiado. Úsalo con un lanzador que admita enlaces personalizados de apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien Backlit copié. Utilisez-le avec un lanceur compatible avec les liens d’app personnalisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit-Link kopiert. Mit einem Launcher verwenden, der eigene App-Links unterstützt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlitリンクをコピーしました。カスタムアプリリンクに対応したランチャーで使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 링크를 복사했습니다. 사용자 지정 앱 링크를 지원하는 실행 도구에서 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Link do Backlit copiado. Use-o com um iniciador compatível com links personalizados de apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已复制 Backlit 链接。请搭配支持自定义应用链接的启动器使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製 Backlit 鏈接。請搭配支持自定義應用鏈接的啓動器使用。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คัดลอกลิงก์ Backlit แล้ว ใช้กับตัวเรียกแอปที่รองรับลิงก์แอปแบบกำหนดเอง"
          }
        }
      }
    },
    "Backlit uses system playback audio for Music mode. It does not save or transmit screen or audio content.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit uses system playback audio for Music mode. It does not save or transmit screen or audio content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit usa el audio de reproducción del sistema en el modo Música. No guarda ni transmite contenido de pantalla ni audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit utilise le son du système pour le mode Musique. Il n’enregistre ni ne transmet le contenu de l’écran ou le son."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit verwendet Systemwiedergabe-Audio für den Musikmodus. Bildschirm- und Audioinhalte werden weder gespeichert noch übertragen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlitは音楽モードでシステムの再生音を使用します。画面や音声の内容を保存・送信することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit은 음악 모드에 시스템 재생 오디오를 사용합니다. 화면이나 오디오 내용을 저장하거나 전송하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Backlit usa o áudio reproduzido pelo sistema no modo Música. Não salva nem transmite conteúdo da tela ou áudio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 在音乐模式中使用系统播放音频，不保存或传输屏幕或音频内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 在音樂模式中使用系統播放音訊，不保存或傳輸螢幕或音訊內容。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit ใช้เสียงที่ระบบเล่นสำหรับโหมดเพลง ไม่บันทึกหรือส่งเนื้อหาหน้าจอหรือเสียง"
          }
        }
      }
    },
    "Backlit will reconnect when your Mac is awake and unlocked.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit will reconnect when your Mac is awake and unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit volverá a conectarse cuando el Mac esté activo y desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit se reconnectera lorsque votre Mac sera éveillé et déverrouillé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit verbindet sich erneut, wenn Ihr Mac wach und entsperrt ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがスリープ解除され、ロックが解除されるとBacklitが再接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 깨어 있고 잠금이 해제되면 Backlit이 다시 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Backlit reconectará quando o Mac estiver ativo e desbloqueado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 唤醒并解锁后，Backlit 将重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 喚醒並解鎖後，Backlit 將重新連接。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit จะเชื่อมต่อใหม่เมื่อ Mac ตื่นและปลดล็อกแล้ว"
          }
        }
      }
    },
    "Backlit will verify cleanup and reconnect when your Mac is awake.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit will verify cleanup and reconnect when your Mac is awake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit comprobará la limpieza y volverá a conectarse cuando el Mac esté activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit vérifiera le nettoyage et se reconnectera lorsque votre Mac sera éveillé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit prüft die Bereinigung und verbindet sich erneut, wenn Ihr Mac wach ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがスリープ解除されると、Backlitが後処理を確認して再接続します。"
