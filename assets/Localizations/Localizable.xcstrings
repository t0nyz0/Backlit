    "Automatic recovery no longer owns the recorded fade session.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic recovery no longer owns the recorded fade session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación automática ya no controla la sesión de transición de brillo registrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration automatique ne contrôle plus la session de transition lumineuse enregistrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Wiederherstellung besitzt die aufgezeichnete Überblendungssitzung nicht mehr."
