        }
      }
    },
    "The ambient brightness change could not be confirmed. Restore the saved limits before retrying.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ambient brightness change could not be confirmed. Restore the saved limits before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el cambio de brillo ambiental. Restaura los límites guardados antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de luminosité ambiante n’a pas pu être confirmé. Rétablissez les limites enregistrées avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung der Umgebungshelligkeit konnte nicht bestätigt werden. Stellen Sie vor einem neuen Versuch die gespeicherten Grenzen wieder her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境光による明るさの変更を確認できませんでした。再試行の前に保存した制限値を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변광 밝기 변경을 확인하지 못했습니다. 다시 시도하기 전에 저장된 제한값을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a alteração do brilho ambiente. Restaure os limites salvos antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认环境光亮度更改。重试前请恢复保存的限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認環境光亮度更改。重試前請恢復保存的限制。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการเปลี่ยนความสว่างตามแสงแวดล้อมไม่ได้ คืนขีดจำกัดที่บันทึกไว้ก่อนลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare la modifica della luminosità ambientale. Ripristina i limiti salvati prima di riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging van de omgevingshelderheid kon niet worden bevestigd. Herstel de opgeslagen limieten voordat je het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić zmiany jasności zależnej od oświetlenia otoczenia. Przywróć zapisane limity przed ponowną próbą."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortam parlaklığı değişikliği doğrulanamadı. Tekrar denemeden önce kayıtlı sınırları geri yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác nhận được thay đổi giới hạn độ sáng theo ánh sáng môi trường. Hãy khôi phục giới hạn đã lưu trước khi thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan batas kecerahan sekitar tidak dapat dikonfirmasi. Pulihkan batas yang tersimpan sebelum mencoba lagi."
          }
        }
      }
    },
