    "Session metadata is incomplete. Some coding sessions may be missing from this snapshot.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session metadata is incomplete. Some coding sessions may be missing from this snapshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos de las sesiones están incompletos. Puede que falten algunas sesiones de programación en este resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées des sessions sont incomplètes. Certaines sessions de programmation peuvent manquer dans cet instantané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungsmetadaten sind unvollständig. Einige Programmiersitzungen fehlen möglicherweise in dieser Übersicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションのメタデータが不完全です。このスナップショットには一部のコーディングセッションが含まれていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 메타데이터가 불완전합니다. 이 스냅샷에 일부 코딩 세션이 누락되었을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os metadados das sessões estão incompletos. Algumas sessões de programação podem não aparecer neste resumo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话元数据不完整，此快照可能缺少部分编程会话。"
          }
