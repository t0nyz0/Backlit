{
  "sourceLanguage": "en",
  "strings": {
    "0% goes fully dark between pulses.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% goes fully dark between pulses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al 0%, la luz se apaga por completo entre pulsos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À 0 %, la lumière s’éteint complètement entre les pulsations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei 0 % ist das Licht zwischen den Pulsen ganz aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0%にすると点滅の間は完全に消灯します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0%로 설정하면 맥박 사이에 완전히 꺼집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 0%, a luz apaga completamente entre as pulsações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 会在脉冲之间完全熄灭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 會在脈衝之間完全熄滅。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "0% จะดับสนิทระหว่างจังหวะ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0% spegne completamente la luce tra un impulso e l’altro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij 0% gaat het licht tussen pulsen helemaal uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy 0% logo całkowicie gaśnie między impulsami."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%0 ayarında logo, atımlar arasında tamamen söner."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức 0% tắt hẳn đèn giữa các nhịp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "0% membuat logo benar-benar gelap di antara denyut."
          }
        }
      }
    },
    "A compatible live Mac is required.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A compatible live Mac is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere un Mac real compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac réel compatible est nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kompatibler echter Mac ist erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する実機のMacが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환되는 실제 Mac이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário um Mac real compatível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要兼容的真实 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要兼容的真實 Mac。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้ Mac จริงที่รองรับ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario un Mac compatibile in uso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een compatibele, actieve Mac is vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany jest zgodny Mac działający poza podglądem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen, gerçek bir Mac gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần dùng máy Mac tương thích."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperlukan Mac yang kompatibel."
          }
        }
      }
    },
    "A new pairing key could not be created, so Home Assistant sharing was switched off. Choose New Pairing Key again before switching it back on. ({detail})": {
      "comment": "Backlit interface template. Preserve every {named} placeholder exactly. Placeholder values are supplied at runtime. {detail} is an arbitrary diagnostic: preserve it verbatim, do not translate or reinterpret it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new pairing key could not be created, so Home Assistant sharing was switched off. Choose New Pairing Key again before switching it back on. ({detail})"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear una nueva clave de emparejamiento, por lo que se desactivó el acceso de Home Assistant. Elige Nueva clave de emparejamiento otra vez antes de volver a activarlo. ({detail})"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer une nouvelle clé d’association : le partage avec Home Assistant a été désactivé. Choisissez à nouveau Nouvelle clé d’association avant de le réactiver. ({detail})"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Kopplungsschlüssel konnte nicht erstellt werden. Die Home-Assistant-Freigabe wurde daher ausgeschaltet. Wählen Sie erneut „Neuer Kopplungsschlüssel“, bevor Sie die Freigabe wieder einschalten. ({detail})"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいペアリングキーを作成できなかったため、Home Assistantとの共有をオフにしました。再度オンにする前に「新しいペアリングキー」をもう一度選んでください。({detail})"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 페어링 키를 생성하지 못해 Home Assistant 공유가 꺼졌습니다. 공유를 다시 켜기 전에 새 페어링 키를 다시 선택하세요. ({detail})"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar uma nova chave de pareamento, então o compartilhamento com o Home Assistant foi desativado. Escolha Nova chave de pareamento novamente antes de reativá-lo. ({detail})"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建新的配对密钥，因此已关闭 Home Assistant 共享。重新启用共享前，请再次选择“新建配对密钥”。（{detail}）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立新的配對金鑰，因此已關閉 Home Assistant 共享。重新啟用共享前，請再次選擇「新建配對金鑰」。（{detail}）"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างคีย์จับคู่ใหม่ไม่สำเร็จ จึงปิดการแชร์กับ Home Assistant แล้ว เลือกคีย์จับคู่ใหม่อีกครั้งก่อนเปิดการแชร์อีกครั้ง ({detail})"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare una nuova chiave di abbinamento. La condivisione con Home Assistant è stata disattivata. Seleziona di nuovo «Nuova chiave di abbinamento» prima di riattivarla. ({detail})"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kon geen nieuwe koppelingssleutel worden aangemaakt. Delen met Home Assistant is daarom uitgeschakeld. Kies opnieuw ‘Nieuwe koppelingssleutel’ voordat je delen weer inschakelt. ({detail})"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć nowego klucza parowania, więc udostępnianie do Home Assistant zostało wyłączone. Przed ponownym włączeniem wybierz jeszcze raz „Nowy klucz parowania”. ({detail})"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni eşleme anahtarı oluşturulamadığı için Home Assistant paylaşımı kapatıldı. Paylaşımı açmadan önce tekrar “Yeni Eşleme Anahtarı”nı seçin. ({detail})"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tạo được khóa ghép nối mới nên tính năng chia sẻ với Home Assistant đã tắt. Hãy chọn Khóa ghép nối mới lần nữa trước khi bật lại. ({detail})"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci pemasangan baru tidak dapat dibuat, sehingga akses Home Assistant dimatikan. Pilih Kunci Pemasangan Baru lagi sebelum menyalakannya kembali. ({detail})"
          }
        }
      }
    },
    "A new pairing key was created. Copy it and update Home Assistant; the old key no longer works.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new pairing key was created. Copy it and update Home Assistant; the old key no longer works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha creado una nueva clave de emparejamiento. Cópiala y actualiza Home Assistant; la clave anterior ya no funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle clé d’appairage a été créée. Copiez-la et mettez à jour Home Assistant ; l’ancienne clé ne fonctionne plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer Kopplungsschlüssel erstellt. Kopieren und in Home Assistant aktualisieren; der alte Schlüssel funktioniert nicht mehr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいペアリングキーを作成しました。コピーしてHome Assistantを更新してください。古いキーは無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 페어링 키를 만들었습니다. 복사해 Home Assistant를 업데이트하세요. 이전 키는 더 이상 작동하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova chave de pareamento foi criada. Copie-a e atualize o Home Assistant; a chave antiga não funciona mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建新的配对密钥。请复制并更新 Home Assistant；旧密钥已失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已創建新的配對金鑰。請複製並更新 Home Assistant；舊金鑰已失效。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างคีย์จับคู่ใหม่แล้ว คัดลอกไปอัปเดตใน Home Assistant คีย์เดิมใช้ไม่ได้แล้ว"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata creata una nuova chiave di abbinamento. Copiala e aggiorna Home Assistant: la vecchia chiave non funziona più."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een nieuwe koppelingssleutel aangemaakt. Kopieer deze en werk Home Assistant bij. De oude sleutel werkt niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzono nowy klucz parowania. Skopiuj go i zaktualizuj konfigurację Home Assistant. Stary klucz już nie działa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni eşleme anahtarı oluşturuldu. Anahtarı kopyalayıp Home Assistant’ta güncelleyin. Eski anahtar artık çalışmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạo khóa ghép nối mới. Hãy sao chép khóa và cập nhật Home Assistant; khóa cũ không còn dùng được."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci pemasangan baru telah dibuat. Salin kunci itu dan perbarui Home Assistant; kunci lama tidak lagi berlaku."
          }
        }
      }
    },
    "A previous light session needs restoration. Use Restore Light to finish its cleanup.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous light session needs restoration. Use Restore Light to finish its cleanup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario restaurar una sesión de luz anterior. Usa Restaurar luz para terminar su limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session d’éclairage précédente doit être restaurée. Utilisez Restaurer la lumière pour terminer son nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Lichtsitzung muss wiederhergestellt werden. Mit „Licht wiederherstellen“ die Bereinigung abschließen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のライトセッションの復元が必要です。「ライトを復元」で後処理を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 조명 세션을 복원해야 합니다. ‘조명 복원’으로 정리를 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão de luz anterior precisa ser restaurada. Use Restaurar luz para concluir a limpeza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的灯光会话需要恢复。请使用“恢复灯光”完成清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的燈光會話需要恢復。請使用“恢復燈光”完成清理。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องกู้คืนเซสชันไฟก่อนหน้า ใช้ “กู้คืนไฟ” เพื่อจัดการสถานะค้างให้เสร็จ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occorre ripristinare la sessione di illuminazione precedente. Seleziona «Ripristina luce» per completare la procedura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eerdere lichtsessie moet worden hersteld. Kies ‘Licht herstellen’ om het opruimen af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzeba przywrócić ustawienia z poprzedniej sesji podświetlenia. Wybierz „Przywróć podświetlenie”, aby zakończyć porządkowanie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir ışık oturumunun ayarları geri yüklenmeli. Temizlemeyi tamamlamak için “Işığı Geri Yükle”yi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần khôi phục phiên chiếu sáng trước. Chọn Khôi phục đèn để hoàn tất dọn dẹp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi lampu sebelumnya perlu dipulihkan. Gunakan Pulihkan Lampu untuk menyelesaikan pembersihannya."
          }
        }
      }
    },
    "A previous session needs restoration. Choose Restore Logo Settings first.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous session needs restoration. Choose Restore Logo Settings first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario restaurar una sesión anterior. Primero elige Restaurar ajustes del logo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session précédente doit être restaurée. Choisissez d’abord Restaurer les réglages du logo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vorherige Sitzung muss wiederhergestellt werden. Wählen Sie zuerst „Logoeinstellungen wiederherstellen“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッションの復元が必要です。まず「ロゴ設定を復元」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 세션을 복원해야 합니다. 먼저 ‘로고 설정 복원’을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão anterior precisa ser restaurada. Primeiro escolha Restaurar ajustes do logo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的会话需要恢复。请先选择“恢复徽标设置”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的會話需要恢復。請先選擇“恢復標誌設定”。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องกู้คืนเซสชันก่อนหน้า เลือก “คืนค่าการตั้งค่าโลโก้” ก่อน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occorre ripristinare una sessione precedente. Seleziona prima «Ripristina luce»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eerdere sessie moet worden hersteld. Kies eerst ‘Licht herstellen’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzeba przywrócić ustawienia z poprzedniej sesji. Najpierw wybierz „Przywróć podświetlenie”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir oturumun ayarları geri yüklenmeli. Önce “Işığı Geri Yükle”yi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần khôi phục phiên trước. Trước tiên, hãy chọn Khôi phục đèn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi sebelumnya perlu dipulihkan. Pilih Pulihkan Lampu terlebih dahulu."
          }
        }
      }
    },
    "A previous session still has a recovery record. Restore Light can request restoration; it does not confirm native handback.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous session still has a recovery record. Restore Light can request restoration; it does not confirm native handback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión anterior aún tiene un registro de recuperación. Restaurar luz puede solicitar la restauración, pero no confirma la devolución del control a macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session précédente possède encore un enregistrement de restauration. Restaurer la lumière permet de demander la restauration, mais ne confirme pas le retour du contrôle à macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Sitzung hat noch einen Wiederherstellungsdatensatz. „Licht wiederherstellen“ kann eine Wiederherstellung anfordern, bestätigt aber nicht die Rückgabe an macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッションの復元記録が残っています。「ライトを復元」は復元を要求できますが、システムへの制御返却を確認するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 세션의 복구 기록이 남아 있습니다. ‘조명 복원’은 복원을 요청할 수 있지만 시스템으로의 제어 반환을 확인하지는 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão anterior ainda tem um registro de recuperação. Restaurar luz pode solicitar a restauração, mas não confirma a devolução do controle ao macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的会话仍有恢复记录。“恢复灯光”可请求恢复，但不代表已确认交还原生控制权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的會話仍有恢復記錄。“恢復燈光”可請求恢復，但不代表已確認交還原生控制權。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมีข้อมูลกู้คืนของเซสชันก่อนหน้า “กู้คืนไฟ” จะร้องขอกู้คืน แต่ไม่ได้ยืนยันว่าคืนการควบคุมให้ระบบแล้ว"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste ancora un record di recupero per una sessione precedente. Puoi richiedere il ripristino con «Ripristina luce», ma la restituzione del controllo a macOS non è confermata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog herstelinformatie voor een eerdere sessie. Met ‘Licht herstellen’ kun je herstel aanvragen, maar daarmee is niet bevestigd dat macOS de bediening terugheeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzednia sesja nadal ma zapis odzyskiwania. Opcja „Przywróć podświetlenie” zleca przywrócenie, ale nie potwierdza oddania sterowania systemowi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir oturumun kurtarma kaydı hâlâ var. “Işığı Geri Yükle” ile geri yüklemeyi isteyebilirsiniz, ancak denetimin macOS’a döndüğünü doğrulamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên trước vẫn còn bản ghi khôi phục. Khôi phục đèn có thể yêu cầu khôi phục nhưng không xác nhận hệ thống đã tiếp quản lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi sebelumnya masih memiliki catatan pemulihan. Pulihkan Lampu dapat meminta pemulihan, tetapi tidak mengonfirmasi bahwa kendali telah dikembalikan ke macOS."
          }
        }
      }
    },
    "A soft glow while idle. A pulse while working. Two blinks when an agent needs you and you're away.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft glow while idle. A pulse while working. Two blinks when an agent needs you and you're away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz tenue en reposo. Un pulso al trabajar. Dos parpadeos cuando un agente te necesita y estás ausente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lumière douce au repos. Une pulsation pendant le travail. Deux clignotements lorsqu’un agent a besoin de vous en votre absence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanftes Leuchten im Leerlauf, Pulsieren bei der Arbeit. Zwei Blinksignale, wenn ein Agent Sie braucht und Sie abwesend sind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中は柔らかく点灯し、作業中はゆっくり点滅します。離席中にエージェントが応答を必要とすると2回点滅します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중에는 은은하게, 작업 중에는 맥박처럼 빛납니다. 자리를 비운 동안 에이전트가 응답을 필요로 하면 두 번 깜박입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz suave em repouso. Uma pulsação durante o trabalho. Duas piscadas quando um agente precisa de você e você está ausente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时柔和发光，工作时脉动。当代理需要您且您不在电脑前时闪烁两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空閒時柔和發光，工作時脈動。當代理需要您且您不在電腦前時閃爍兩次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สว่างเบา ๆ เมื่อว่าง สว่างเป็นจังหวะขณะทำงาน และกะพริบสองครั้งเมื่อเอเจนต์ต้องการคุณขณะที่คุณไม่อยู่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una luce tenue durante l’attesa. Un impulso durante il lavoro. Due lampeggi quando un agente richiede attenzione e non sei al Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachte gloed tijdens het wachten. Een puls tijdens het werken. Twee flitsen als een agent je nodig heeft en je niet bij je Mac bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatna poświata w spoczynku. Pulsowanie podczas pracy. Dwa mignięcia, gdy agent potrzebuje Twojej uwagi pod Twoją nieobecność."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boştayken hafifçe parlar. Çalışırken atım yapar. Siz uzaktayken bir ajan ilginizi bekliyorsa iki kez yanıp söner."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đèn sáng nhẹ khi rảnh, sáng theo nhịp khi đang làm việc và nháy hai lần khi tác nhân cần bạn mà bạn đang vắng mặt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cahaya lembut saat tidak aktif. Berdenyut saat bekerja. Berkedip dua kali saat agen memerlukan Anda dan Anda sedang tidak di tempat."
          }
        }
      }
    },
    "AI access remains off because its key could not be replaced. ": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI access remains off because its key could not be replaced. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de IA sigue desactivado porque no se pudo reemplazar su clave. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès IA reste désactivé, car sa clé n’a pas pu être remplacée. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Zugriff bleibt aus, da der Schlüssel nicht ersetzt werden konnte. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを交換できなかったため、AIアクセスはオフのままです。 "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 교체하지 못해 AI 접근은 꺼진 상태로 유지됩니다. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de IA continua desativado porque não foi possível substituir a chave. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更换密钥，AI 访问仍保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更換金鑰，AI 訪問仍保持關閉。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึง AI ยังปิดอยู่เนื่องจากเปลี่ยนคีย์ไม่ได้ "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso all’IA rimane disattivato perché non è stato possibile sostituire la chiave. "
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-toegang blijft uit omdat de sleutel niet kon worden vervangen. "
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp AI pozostaje wyłączony, ponieważ nie udało się wymienić jego klucza. "
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarı değiştirilemediği için yapay zekâ erişimi kapalı kalıyor. "
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập AI vẫn tắt vì không thay được khóa. "
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses AI tetap mati karena kuncinya tidak dapat diganti. "
          }
        }
      }
    },
