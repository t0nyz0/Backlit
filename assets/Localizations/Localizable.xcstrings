    "Your light was restored. Turn closed-lid lighting off and on to retry.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light was restored. Turn closed-lid lighting off and on to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauró la luz. Desactiva y vuelve a activar la luz con tapa cerrada para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre lumière a été restaurée. Désactivez puis réactivez l’éclairage capot fermé pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Licht wurde wiederhergestellt. Schalten Sie die Deckelbeleuchtung aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトを復元しました。再試行するには、画面を閉じた状態の点灯をオフにしてからオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명을 복원했습니다. 덮개 닫힘 조명을 껐다 켜서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz foi restaurada. Desative e reative a luz com a tampa fechada para tentar novamente."
          }
        },
