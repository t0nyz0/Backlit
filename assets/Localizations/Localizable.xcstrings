            "value": "Lichtwiederherstellung läuft noch. Danach erneut beenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトの復元はまだ進行中です。完了後に終了を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명 복구가 아직 진행 중입니다. 끝나면 종료를 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recuperação da luz ainda está em andamento. Tente sair novamente quando terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在恢复灯光，完成后请重试退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在恢復燈光，完成後請重試退出。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังอยู่ระหว่างกู้คืนไฟ ลองออกอีกครั้งเมื่อเสร็จ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristino della luce ancora in corso. Riprova a uscire una volta terminato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichtherstel is nog bezig. Probeer opnieuw te stoppen zodra het klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal trwa odzyskiwanie podświetlenia. Po jego zakończeniu ponownie wybierz „Zakończ”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işık kurtarma hâlâ sürüyor. Tamamlandığında tekrar çıkmayı deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang khôi phục đèn. Hãy thử thoát lại khi hoàn tất."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan lampu masih berlangsung. Coba keluar lagi setelah selesai."
          }
        }
      }
    },
