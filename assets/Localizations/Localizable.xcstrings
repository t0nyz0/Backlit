    "Adapts to playback level. Intensity adjusts the result; your brightness sets its ceiling.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapts to playback level. Intensity adjusts the result; your brightness sets its ceiling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adapta al volumen de reproducción. La intensidad ajusta la respuesta; el brillo fija su límite máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’adapte au niveau sonore. L’intensité ajuste la réponse ; votre luminosité fixe son plafond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt sich dem Wiedergabepegel an. Die Intensität verändert das Ergebnis; Ihre Helligkeit legt die Obergrenze fest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生音量に合わせて変化します。強度で反応を調整し、明るさ設定が上限になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 음량에 맞춰 조절합니다. 강도는 반응을 조절하고 밝기 설정은 최대 밝기를 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adapta-se ao nível do áudio. A intensidade ajusta a resposta; o brilho define o limite máximo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动适应播放音量。强度调整响应效果，您设置的亮度决定上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動適應播放音量。強度調整響應效果，您設定的亮度決定上限。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับตามระดับเสียงที่เล่น ความแรงปรับการตอบสนอง ส่วนความสว่างที่ตั้งไว้เป็นขีดสูงสุด"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si adatta al volume di riproduzione. L’intensità regola l’effetto; la luminosità impostata ne indica il limite."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past zich aan het afspeelniveau aan. Met de intensiteit regel je het effect. Je helderheidsinstelling bepaalt het maximum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosowuje się do głośności odtwarzania. Intensywność zmienia efekt, a ustawienie jasności wyznacza jego maksimum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalma sesinin düzeyine uyum sağlar. Yoğunluk tepkiyi ayarlar. Parlaklık ayarınız üst sınırı belirler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự điều chỉnh theo mức âm thanh phát. Cường độ điều chỉnh hiệu ứng; độ sáng bạn đặt là mức tối đa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyesuaikan dengan tingkat audio yang diputar. Intensitas mengatur hasilnya; kecerahan yang Anda pilih menjadi batas maksimum."
          }
        }
      }
    },
    "Agent settings appeared during connection. Nothing was overwritten. Review them and try again.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent settings appeared during connection. Nothing was overwritten. Review them and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes del agente aparecieron durante la conexión. No se sobrescribió nada. Revísalos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des réglages de l’agent sont apparus pendant la connexion. Rien n’a été écrasé. Vérifiez-les et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenteneinstellungen sind während der Verbindung hinzugekommen. Nichts wurde überschrieben. Prüfen Sie sie und versuchen Sie es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中にエージェント設定が作成されました。何も上書きしていません。設定を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 중 에이전트 설정이 생성되었습니다. 덮어쓴 내용은 없습니다. 설정을 검토하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes do agente apareceram durante a conexão. Nada foi sobrescrito. Revise-os e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接期间出现了代理设置。未覆盖任何内容。请检查后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接期間出現了代理設定。未覆蓋任何內容。請檢查後重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการตั้งค่าเอเจนต์ปรากฏขึ้นระหว่างเชื่อมต่อ ไม่ได้เขียนทับข้อมูลใด ๆ ตรวจสอบแล้วลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la connessione sono comparse impostazioni dell’agente. Non è stato sovrascritto nulla. Controllale e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het verbinden zijn agentinstellingen verschenen. Er is niets overschreven. Controleer de instellingen en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas łączenia pojawiły się ustawienia agenta. Niczego nie nadpisano. Sprawdź ustawienia i spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı sırasında ajan ayarları ortaya çıktı. Hiçbir ayarın üzerine yazılmadı. Ayarları gözden geçirip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt tác nhân xuất hiện trong khi kết nối. Không có gì bị ghi đè. Hãy xem lại rồi thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan agen muncul saat penyambungan. Tidak ada yang ditimpa. Tinjau pengaturannya, lalu coba lagi."
          }
        }
      }
    },
