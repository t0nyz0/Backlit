            "state": "translated",
            "value": "The MCP connection was switched off because its Keychain key is unavailable. Enable it again in Connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión MCP se desactivó porque su clave del Llavero no está disponible. Vuelve a activarla en Conexiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion MCP a été désactivée, car sa clé du trousseau est indisponible. Réactivez-la dans Connexions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die MCP-Verbindung wurde ausgeschaltet, weil ihr Schlüssel im Schlüsselbund nicht verfügbar ist. Aktivieren Sie sie unter „Verbindungen“ erneut."
