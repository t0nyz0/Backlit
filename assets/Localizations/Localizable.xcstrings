    "Your light was restored. Turn closed-lid lighting off and on to retry.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your light was restored. Turn closed-lid lighting off and on to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauró la luz. Desactiva y vuelve a activar la luz con tapa cerrada para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre lumière a été restaurée. Désactivez puis réactivez l’éclairage capot fermé pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Licht wurde wiederhergestellt. Schalten Sie die Deckelbeleuchtung aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライトを復元しました。再試行するには、画面を閉じた状態の点灯をオフにしてからオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명을 복원했습니다. 덮개 닫힘 조명을 껐다 켜서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua luz foi restaurada. Desative e reative a luz com a tampa fechada para tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灯光已恢复。请关闭并重新开启合盖灯光以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燈光已恢復。請關閉並重新開啓闔蓋燈光以重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนไฟแล้ว ปิดและเปิดไฟเมื่อปิดฝาจอเพื่อลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce è stata ripristinata. Disattiva e riattiva l’illuminazione a coperchio chiuso per riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je licht is hersteld. Schakel verlichting bij gesloten deksel uit en weer in om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócono podświetlenie. Wyłącz i ponownie włącz podświetlanie przy zamkniętej pokrywie, aby ponowić próbę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığınız geri yüklendi. Tekrar denemek için kapak kapalıyken aydınlatmayı kapatıp açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục đèn. Hãy tắt và bật lại đèn khi đóng nắp để thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampu telah dipulihkan. Matikan dan nyalakan kembali pencahayaan saat penutup tertutup untuk mencoba lagi."
          }
        }
      }
    },
