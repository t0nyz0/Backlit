    "Recovery ownership changed during verification. Restore your light before retrying.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery ownership changed during verification. Restore your light before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El responsable de la recuperación cambió durante la verificación. Restaura la luz antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le responsable de la restauration a changé pendant la vérification. Restaurez la lumière avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zuständigkeit für die Wiederherstellung hat sich während der Prüfung geändert. Stellen Sie vor einem neuen Versuch Ihr Licht wieder her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中に復元処理の管理主体が変わりました。再試行の前にライトを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 중 복구 제어 주체가 변경되었습니다. 다시 시도하기 전에 조명을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O responsável pela recuperação mudou durante a verificação. Restaure a luz antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证期间恢复控制权发生变化。请在重试前恢复灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證期間恢復控制權發生變化。請在重試前恢復燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ควบคุมการกู้คืนเปลี่ยนระหว่างตรวจสอบ กู้คืนไฟก่อนลองใหม่"
          }
        }
      }
    },
    "Recovery unconfirmed. Your closed-lid choice is saved and remains paused. Review recovery in Settings.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery unconfirmed. Your closed-lid choice is saved and remains paused. Review recovery in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperación sin confirmar. Tu elección para la tapa cerrada está guardada y sigue en pausa. Revisa la recuperación en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauration non confirmée. Votre choix pour le capot fermé est enregistré et reste en pause. Vérifiez la restauration dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung unbestätigt. Die Deckelauswahl ist gespeichert und bleibt pausiert. Wiederherstellung in den Einstellungen prüfen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元は未確認です。画面を閉じた状態の設定は保存され、一時停止のままです。設定で復元を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구가 확인되지 않았습니다. 덮개 닫힘 설정은 저장되어 일시 중지된 상태입니다. 설정에서 복구를 검토하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperação não confirmada. Sua escolha para a tampa fechada está salva e continua pausada. Revise a recuperação em Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复尚未确认。合盖选择已保存并继续暂停。请在设置中检查恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復尚未確認。合蓋選擇已保存並繼續暫停。請在設定中檢查恢復。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังยืนยันการกู้คืนไม่ได้ บันทึกตัวเลือกเมื่อปิดฝาจอไว้และยังหยุดชั่วคราว ตรวจการกู้คืนในการตั้งค่า"
          }
        }
      }
    },
    "Remembered. Open the lid before starting another timed session.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered. Open the lid before starting another timed session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Abre la tapa antes de iniciar otra sesión temporizada."
          }
