          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo. Aguardando novas verificações de segurança do hardware com o Mac ativo e desbloqueado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记住。正在等待 Mac 唤醒并解锁后的新硬件安全检查。"
