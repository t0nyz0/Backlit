{
  "sourceLanguage": "en",
  "strings": {
    "0% goes fully dark between pulses.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% goes fully dark between pulses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al 0%, la luz se apaga por completo entre pulsos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À 0 %, la lumière s’éteint complètement entre les pulsations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei 0 % ist das Licht zwischen den Pulsen ganz aus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0%にすると点滅の間は完全に消灯します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0%로 설정하면 맥박 사이에 완전히 꺼집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 0%, a luz apaga completamente entre as pulsações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 会在脉冲之间完全熄灭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 會在脈衝之間完全熄滅。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "0% จะดับสนิทระหว่างจังหวะ"
          }
        }
      }
    },
    "A compatible live Mac is required.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A compatible live Mac is required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere un Mac real compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Mac réel compatible est nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kompatibler echter Mac ist erforderlich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する実機のMacが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환되는 실제 Mac이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário um Mac real compatível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要兼容的真实 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要兼容的真實 Mac。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้ Mac จริงที่รองรับ"
          }
        }
      }
    },
    "A new pairing key could not be created, so Home Assistant sharing was switched off. Choose New Pairing Key again before switching it back on. ({detail})": {
      "comment": "Backlit interface template. Preserve every {named} placeholder exactly. Placeholder values are supplied at runtime. {detail} is an arbitrary diagnostic: preserve it verbatim, do not translate or reinterpret it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new pairing key could not be created, so Home Assistant sharing was switched off. Choose New Pairing Key again before switching it back on. ({detail})"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear una nueva clave de emparejamiento, por lo que se desactivó el acceso de Home Assistant. Elige Nueva clave de emparejamiento otra vez antes de volver a activarlo. ({detail})"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer une nouvelle clé d’association : le partage avec Home Assistant a été désactivé. Choisissez à nouveau Nouvelle clé d’association avant de le réactiver. ({detail})"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Kopplungsschlüssel konnte nicht erstellt werden. Die Home-Assistant-Freigabe wurde daher ausgeschaltet. Wählen Sie erneut „Neuer Kopplungsschlüssel“, bevor Sie die Freigabe wieder einschalten. ({detail})"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいペアリングキーを作成できなかったため、Home Assistantとの共有をオフにしました。再度オンにする前に「新しいペアリングキー」をもう一度選んでください。({detail})"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 페어링 키를 생성하지 못해 Home Assistant 공유가 꺼졌습니다. 공유를 다시 켜기 전에 새 페어링 키를 다시 선택하세요. ({detail})"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar uma nova chave de pareamento, então o compartilhamento com o Home Assistant foi desativado. Escolha Nova chave de pareamento novamente antes de reativá-lo. ({detail})"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建新的配对密钥，因此已关闭 Home Assistant 共享。重新启用共享前，请再次选择“新建配对密钥”。（{detail}）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立新的配對金鑰，因此已關閉 Home Assistant 共享。重新啟用共享前，請再次選擇「新建配對金鑰」。（{detail}）"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างคีย์จับคู่ใหม่ไม่สำเร็จ จึงปิดการแชร์กับ Home Assistant แล้ว เลือกคีย์จับคู่ใหม่อีกครั้งก่อนเปิดการแชร์อีกครั้ง ({detail})"
          }
        }
      }
    },
    "A new pairing key was created. Copy it and update Home Assistant; the old key no longer works.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new pairing key was created. Copy it and update Home Assistant; the old key no longer works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha creado una nueva clave de emparejamiento. Cópiala y actualiza Home Assistant; la clave anterior ya no funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle clé d’appairage a été créée. Copiez-la et mettez à jour Home Assistant ; l’ancienne clé ne fonctionne plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer Kopplungsschlüssel erstellt. Kopieren und in Home Assistant aktualisieren; der alte Schlüssel funktioniert nicht mehr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいペアリングキーを作成しました。コピーしてHome Assistantを更新してください。古いキーは無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 페어링 키를 만들었습니다. 복사해 Home Assistant를 업데이트하세요. 이전 키는 더 이상 작동하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova chave de pareamento foi criada. Copie-a e atualize o Home Assistant; a chave antiga não funciona mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建新的配对密钥。请复制并更新 Home Assistant；旧密钥已失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已創建新的配對金鑰。請複製並更新 Home Assistant；舊金鑰已失效。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างคีย์จับคู่ใหม่แล้ว คัดลอกไปอัปเดตใน Home Assistant คีย์เดิมใช้ไม่ได้แล้ว"
          }
        }
      }
    },
    "A previous light session needs restoration. Use Restore Light to finish its cleanup.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous light session needs restoration. Use Restore Light to finish its cleanup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario restaurar una sesión de luz anterior. Usa Restaurar luz para terminar su limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session d’éclairage précédente doit être restaurée. Utilisez Restaurer la lumière pour terminer son nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Lichtsitzung muss wiederhergestellt werden. Mit „Licht wiederherstellen“ die Bereinigung abschließen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のライトセッションの復元が必要です。「ライトを復元」で後処理を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 조명 세션을 복원해야 합니다. ‘조명 복원’으로 정리를 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão de luz anterior precisa ser restaurada. Use Restaurar luz para concluir a limpeza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的灯光会话需要恢复。请使用“恢复灯光”完成清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的燈光會話需要恢復。請使用“恢復燈光”完成清理。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องกู้คืนเซสชันไฟก่อนหน้า ใช้ “กู้คืนไฟ” เพื่อจัดการสถานะค้างให้เสร็จ"
          }
        }
      }
    },
    "A previous session needs restoration. Choose Restore Logo Settings first.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous session needs restoration. Choose Restore Logo Settings first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es necesario restaurar una sesión anterior. Primero elige Restaurar ajustes del logo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session précédente doit être restaurée. Choisissez d’abord Restaurer les réglages du logo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vorherige Sitzung muss wiederhergestellt werden. Wählen Sie zuerst „Logoeinstellungen wiederherstellen“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッションの復元が必要です。まず「ロゴ設定を復元」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 세션을 복원해야 합니다. 먼저 ‘로고 설정 복원’을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão anterior precisa ser restaurada. Primeiro escolha Restaurar ajustes do logo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的会话需要恢复。请先选择“恢复徽标设置”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的會話需要恢復。請先選擇“恢復標誌設定”。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องกู้คืนเซสชันก่อนหน้า เลือก “คืนค่าการตั้งค่าโลโก้” ก่อน"
          }
        }
      }
    },
    "A previous session still has a recovery record. Restore Light can request restoration; it does not confirm native handback.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous session still has a recovery record. Restore Light can request restoration; it does not confirm native handback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sesión anterior aún tiene un registro de recuperación. Restaurar luz puede solicitar la restauración, pero no confirma la devolución del control a macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une session précédente possède encore un enregistrement de restauration. Restaurer la lumière permet de demander la restauration, mais ne confirme pas le retour du contrôle à macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Sitzung hat noch einen Wiederherstellungsdatensatz. „Licht wiederherstellen“ kann eine Wiederherstellung anfordern, bestätigt aber nicht die Rückgabe an macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のセッションの復元記録が残っています。「ライトを復元」は復元を要求できますが、システムへの制御返却を確認するものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 세션의 복구 기록이 남아 있습니다. ‘조명 복원’은 복원을 요청할 수 있지만 시스템으로의 제어 반환을 확인하지는 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sessão anterior ainda tem um registro de recuperação. Restaurar luz pode solicitar a restauração, mas não confirma a devolução do controle ao macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的会话仍有恢复记录。“恢复灯光”可请求恢复，但不代表已确认交还原生控制权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的會話仍有恢復記錄。“恢復燈光”可請求恢復，但不代表已確認交還原生控制權。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังมีข้อมูลกู้คืนของเซสชันก่อนหน้า “กู้คืนไฟ” จะร้องขอกู้คืน แต่ไม่ได้ยืนยันว่าคืนการควบคุมให้ระบบแล้ว"
          }
        }
      }
    },
    "A soft glow while idle. A pulse while working. Two blinks when an agent needs you and you're away.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soft glow while idle. A pulse while working. Two blinks when an agent needs you and you're away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz tenue en reposo. Un pulso al trabajar. Dos parpadeos cuando un agente te necesita y estás ausente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lumière douce au repos. Une pulsation pendant le travail. Deux clignotements lorsqu’un agent a besoin de vous en votre absence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanftes Leuchten im Leerlauf, Pulsieren bei der Arbeit. Zwei Blinksignale, wenn ein Agent Sie braucht und Sie abwesend sind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中は柔らかく点灯し、作業中はゆっくり点滅します。離席中にエージェントが応答を必要とすると2回点滅します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중에는 은은하게, 작업 중에는 맥박처럼 빛납니다. 자리를 비운 동안 에이전트가 응답을 필요로 하면 두 번 깜박입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz suave em repouso. Uma pulsação durante o trabalho. Duas piscadas quando um agente precisa de você e você está ausente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲时柔和发光，工作时脉动。当代理需要您且您不在电脑前时闪烁两次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空閒時柔和發光，工作時脈動。當代理需要您且您不在電腦前時閃爍兩次。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สว่างเบา ๆ เมื่อว่าง สว่างเป็นจังหวะขณะทำงาน และกะพริบสองครั้งเมื่อเอเจนต์ต้องการคุณขณะที่คุณไม่อยู่"
          }
        }
      }
    },
    "AI access remains off because its key could not be replaced. ": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI access remains off because its key could not be replaced. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso de IA sigue desactivado porque no se pudo reemplazar su clave. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès IA reste désactivé, car sa clé n’a pas pu être remplacée. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Zugriff bleibt aus, da der Schlüssel nicht ersetzt werden konnte. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを交換できなかったため、AIアクセスはオフのままです。 "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 교체하지 못해 AI 접근은 꺼진 상태로 유지됩니다. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de IA continua desativado porque não foi possível substituir a chave. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更换密钥，AI 访问仍保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更換金鑰，AI 訪問仍保持關閉。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึง AI ยังปิดอยู่เนื่องจากเปลี่ยนคีย์ไม่ได้ "
          }
        }
      }
    },
    "AI access remains off because its key could not be replaced. {detail}": {
      "comment": "Backlit interface template. Preserve every {named} placeholder exactly. Placeholder values are supplied at runtime. {detail} is an arbitrary diagnostic: preserve it verbatim, do not translate or reinterpret it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI access remains off because its key could not be replaced. {detail}"
          }
        },
        "es": {
          "stringUnit": {
