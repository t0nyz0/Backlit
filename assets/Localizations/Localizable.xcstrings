    "Replace the pairing key if it may have been seen by someone else": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the pairing key if it may have been seen by someone else"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza la clave de emparejamiento si alguien más podría haberla visto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
