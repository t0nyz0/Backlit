    "macOS could not show the Dock icon. Backlit will keep its menu bar entry available.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS could not show the Dock icon. Backlit will keep its menu bar entry available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo mostrar el icono del Dock. Backlit mantendrá disponible su entrada en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas pu afficher l’icône du Dock. Backlit conservera son entrée dans la barre des menus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte das Dock-Symbol nicht anzeigen. Backlit bleibt in der Menüleiste verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでDockアイコンを表示できませんでした。Backlitのメニューバー項目は引き続き表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 Dock 아이콘을 표시하지 못했습니다. Backlit은 메뉴 막대 항목을 계속 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não conseguiu mostrar o ícone do Dock. O Backlit manterá sua entrada na barra de menus disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法显示 Dock 图标。Backlit 将继续保留菜单栏入口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 無法顯示 Dock 圖標。Backlit 將繼續保留菜單欄入口。"
          }
        },
        "th": {
          "stringUnit": {
