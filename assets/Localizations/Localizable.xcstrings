    "Local connections were switched off because the listener failed. ": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local connections were switched off because the listener failed. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desactivaron las conexiones locales porque falló el servicio de escucha. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions locales ont été désactivées en raison d’une défaillance du service d’écoute. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Verbindungen wurden wegen eines Listener-Fehlers ausgeschaltet. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リスナーの障害によりローカル接続をオフにしました。 "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리스너 오류로 로컬 연결이 꺼졌습니다. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conexões locais foram desativadas porque o serviço de escuta falhou. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监听器失败，本地连接已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監聽器失敗，本地連接已關閉。"
