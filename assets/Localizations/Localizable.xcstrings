        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 연결 키를 교체했습니다. 모든 어시스턴트 연결을 중단하려면 AI 접근을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de conexão de IA foi substituída. Desative o acesso de IA para encerrar todas as conexões de assistentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已更换 AI 连接密钥。关闭 AI 访问可停止所有助手连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已更換 AI 連接金鑰。關閉 AI 訪問可停止所有助手連接。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนคีย์การเชื่อมต่อ AI แล้ว ปิดการเข้าถึง AI เพื่อหยุดการเชื่อมต่อผู้ช่วยทั้งหมด"
          }
        }
      }
    },
    "The current key stops working immediately. Home Assistant will ask for the new key before it can control the light again.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current key stops working immediately. Home Assistant will ask for the new key before it can control the light again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave actual dejará de funcionar inmediatamente. Home Assistant pedirá la nueva clave antes de poder controlar la luz de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé actuelle cesse immédiatement de fonctionner. Home Assistant demandera la nouvelle clé avant de pouvoir contrôler à nouveau la lumière."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Schlüssel funktioniert sofort nicht mehr. Home Assistant benötigt den neuen Schlüssel, bevor es das Licht wieder steuern kann."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のキーは直ちに無効になります。Home Assistantで再びライトを制御するには、新しいキーの入力が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 키는 즉시 작동을 멈춥니다. Home Assistant가 조명을 다시 제어하려면 새 키를 입력해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave atual para de funcionar imediatamente. O Home Assistant pedirá a nova chave antes de poder controlar a luz novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前密钥将立即失效。Home Assistant 需要新密钥才能再次控制灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前金鑰將立即失效。Home Assistant 需要新金鑰才能再次控制燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ปัจจุบันจะใช้ไม่ได้ทันที Home Assistant จะขอคีย์ใหม่ก่อนควบคุมไฟได้อีกครั้ง"
          }
        }
      }
    },
    "The light turns off shortly after typing stops. With the lid closed, use an external keyboard.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light turns off shortly after typing stops. With the lid closed, use an external keyboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz se apaga poco después de dejar de escribir. Con la tapa cerrada, usa un teclado externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière s’éteint peu après l’arrêt de la saisie. Capot fermé, utilisez un clavier externe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Licht erlischt kurz nach dem Tippen. Bei geschlossenem Deckel eine externe Tastatur verwenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイピングが止まると、まもなく消灯します。画面を閉じた状態では外付けキーボードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이핑을 멈추면 잠시 후 조명이 꺼집니다. 덮개를 닫은 상태에서는 외장 키보드를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz apaga logo após você parar de digitar. Com a tampa fechada, use um teclado externo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止打字后灯光很快熄灭。合盖时请使用外接键盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止打字後燈光很快熄滅。合蓋時請使用外接鍵盤。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟจะดับไม่นานหลังหยุดพิมพ์ ใช้แป้นพิมพ์ภายนอกเมื่อปิดฝาจอ"
          }
        }
      }
    },
    "The logo hardware produces white light. Backlit changes its brightness and rhythm, never the screen brightness. ": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo hardware produces white light. Backlit changes its brightness and rhythm, never the screen brightness. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hardware del logo produce luz blanca. Backlit cambia su brillo y ritmo, nunca el brillo de la pantalla. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matériel du logo produit une lumière blanche. Backlit modifie sa luminosité et son rythme, jamais la luminosité de l’écran. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Logo-Hardware erzeugt weißes Licht. Backlit ändert Helligkeit und Rhythmus, niemals die Bildschirmhelligkeit. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴのハードウェアは白色光を発します。Backlitが変更するのはロゴの明るさとリズムだけで、画面の明るさは変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고 하드웨어는 흰빛을 냅니다. Backlit은 로고의 밝기와 리듬만 바꾸며 화면 밝기는 바꾸지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O hardware do logo produz luz branca. O Backlit altera seu brilho e ritmo, nunca o brilho da tela. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "徽标硬件发出白光。Backlit 只改变其亮度和节奏，绝不改变屏幕亮度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "徽標硬體發出白光。Backlit 只改變其亮度和節奏，絕不改變螢幕亮度。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฮาร์ดแวร์โลโก้ให้แสงสีขาว Backlit เปลี่ยนเฉพาะความสว่างและจังหวะของโลโก้ ไม่เปลี่ยนความสว่างหน้าจอ"
          }
        }
      }
    },
    "The previous key stops working. Your local assistants can reconnect while AI access stays enabled. The Home Assistant key stays the same.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous key stops working. Your local assistants can reconnect while AI access stays enabled. The Home Assistant key stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave anterior deja de funcionar. Tus asistentes locales podrán reconectarse mientras el acceso de IA siga activado. La clave de Home Assistant no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancienne clé cesse de fonctionner. Vos assistants locaux peuvent se reconnecter tant que l’accès IA reste activé. La clé Home Assistant reste inchangée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bisherige Schlüssel funktioniert nicht mehr. Lokale Assistenten können sich bei aktiviertem KI-Zugriff erneut verbinden. Der Home-Assistant-Schlüssel bleibt unverändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のキーは無効になります。AIアクセスが有効な間はローカルアシスタントが再接続できます。Home Assistantのキーは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 키는 더 이상 작동하지 않습니다. AI 접근이 켜져 있으면 로컬 어시스턴트가 다시 연결할 수 있습니다. Home Assistant 키는 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave anterior para de funcionar. Seus assistentes locais podem reconectar enquanto o acesso de IA estiver ativado. A chave do Home Assistant continua a mesma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧密钥将失效。只要 AI 访问保持开启，本地助手就能重新连接。Home Assistant 密钥不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊金鑰將失效。只要 AI 訪問保持開啓，本地助手就能重新連接。Home Assistant 金鑰不會改變。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์เดิมจะใช้ไม่ได้ ผู้ช่วยภายในเครื่องเชื่อมต่อใหม่ได้ขณะเปิดการเข้าถึง AI คีย์ Home Assistant ไม่เปลี่ยน"
