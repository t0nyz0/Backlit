            "state": "translated",
            "value": "Backlit akan menyambung kembali saat Mac aktif dan tidak terkunci."
          }
        }
      }
    },
    "Backlit will verify cleanup and reconnect when your Mac is awake.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit will verify cleanup and reconnect when your Mac is awake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit comprobará la limpieza y volverá a conectarse cuando el Mac esté activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit vérifiera le nettoyage et se reconnectera lorsque votre Mac sera éveillé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit prüft die Bereinigung und verbindet sich erneut, wenn Ihr Mac wach ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macがスリープ解除されると、Backlitが後処理を確認して再接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 깨어나면 Backlit이 정리를 확인하고 다시 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Backlit verificará a limpeza e reconectará quando o Mac estiver ativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 唤醒后，Backlit 将验证清理结果并重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 喚醒後，Backlit 將驗證清理結果並重新連接。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit จะตรวจการล้างสถานะและเชื่อมต่อใหม่เมื่อ Mac ตื่น"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit verificherà il completamento del ripristino e si riconnetterà quando il Mac sarà attivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit controleert of het herstel is voltooid en maakt opnieuw verbinding wanneer je Mac actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit sprawdzi, czy porządkowanie się zakończyło, i połączy się ponownie po wybudzeniu Maca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’iniz uyandığında Backlit temizliği doğrular ve yeniden bağlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit sẽ xác minh việc dọn dẹp và kết nối lại khi máy Mac thức."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit akan memverifikasi pembersihan dan menyambung kembali saat Mac aktif."
          }
        }
      }
    },
