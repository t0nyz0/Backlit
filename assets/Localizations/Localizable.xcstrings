    "Default: automatic charging pulse, 6-second cycle, dims to 0%, charge-ready signal off.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default: automatic charging pulse, 6-second cycle, dims to 0%, charge-ready signal off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto: pulso de carga automático, ciclo de 6 segundos, atenuación al 0% y señal de carga alcanzada desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
