            "value": "Mémorisé. Ouvrez le capot avant de démarrer une autre session minutée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Deckel öffnen, bevor eine neue zeitbegrenzte Sitzung beginnt."
          }
        },
        "ja": {
