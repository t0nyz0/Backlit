            "value": "Update paused. Finish restoring the light, then retry installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización en pausa. Termina de restaurar la luz y vuelve a intentar la instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour suspendue. Terminez la restauration de la lumière, puis réessayez l’installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update pausiert. Lichtwiederherstellung abschließen, dann Installation erneut versuchen."
