    "Legacy mapping verification is available only with the physical lid open.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy mapping verification is available only with the physical lid open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación del mapeo heredado solo está disponible con la tapa físicamente abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
