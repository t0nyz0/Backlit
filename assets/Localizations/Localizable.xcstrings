    "Allows Backlit links to change the light. Native Shortcuts actions are unavailable in this build.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows Backlit links to change the light. Native Shortcuts actions are unavailable in this build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que los enlaces de Backlit cambien la luz. Las acciones nativas de Atajos no están disponibles en esta compilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les liens Backlit à modifier la lumière. Les actions natives de Raccourcis ne sont pas disponibles dans cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Backlit-Links, das Licht zu ändern. Native Kurzbefehle-Aktionen sind in diesem Build nicht verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlitリンクによるライトの変更を許可します。このビルドではネイティブのショートカットアクションは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 링크가 조명을 변경하도록 허용합니다. 이 빌드에서는 기본 단축어 동작을 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que links do Backlit alterem a luz. Ações nativas do Atalhos não estão disponíveis nesta compilação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Backlit 链接控制灯光。此构建版本不支持原生“快捷指令”操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Backlit 鏈接控制燈光。此構建版本不支持原生“快捷指令”操作。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ลิงก์ Backlit เปลี่ยนไฟได้ บิลด์นี้ยังใช้คำสั่งดั้งเดิมของแอปคำสั่งลัดไม่ได้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente ai link di Backlit di modificare la luce. Le azioni native di Comandi Rapidi non sono disponibili in questa versione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee mogen Backlit-links het licht wijzigen. Systeemeigen Opdrachten-acties zijn niet beschikbaar in deze build."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala łączom Backlit zmieniać podświetlenie. Natywne czynności aplikacji Skróty są niedostępne w tej wersji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
