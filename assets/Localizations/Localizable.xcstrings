    "Cleanup returned, but saved closed-lid handback remains unconfirmed.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup returned, but saved closed-lid handback remains unconfirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intento de limpieza terminó, pero sigue sin confirmarse la devolución del control guardada para la tapa cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tentative de nettoyage est terminée, mais le retour de contrôle enregistré pour le capot fermé reste non confirmé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung zurückgemeldet, aber die Rückgabe der Deckelsteuerung ist weiterhin unbestätigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後処理は終了しましたが、保存済みの閉じた画面のセッションの制御返却は未確認です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 작업이 반환되었지만 저장된 덮개 닫힘 세션의 제어 반환은 아직 확인되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tentativa de limpeza terminou, mas a devolução do controle salva para a tampa fechada continua sem confirmação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理已返回，但仍未确认已交还保存的合盖控制权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理已返回，但仍未確認已交還保存的合蓋控制權。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอนล้างสถานะกลับมาแล้ว แต่ยังยืนยันการคืนการควบคุมของเซสชันปิดฝาจอที่บันทึกไว้ไม่ได้"
          }
        }
      }
    },
    "Closed-lid cleanup could not be confirmed. Review power recovery in Settings, then retry.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closed-lid cleanup could not be confirmed. Review power recovery in Settings, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la limpieza de la sesión con tapa cerrada. Revisa la recuperación de energía en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la session capot fermé n’a pas pu être confirmé. Vérifiez la restauration de l’alimentation dans Réglages, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelbereinigung konnte nicht bestätigt werden. Energiewiederherstellung in den Einstellungen prüfen, dann erneut versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた画面のセッションの後処理を確認できませんでした。設定で電源の復元を確認してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 닫힘 세션의 정리를 확인하지 못했습니다. 설정에서 전원 복구를 검토한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a limpeza da sessão com a tampa fechada. Revise a recuperação de energia em Ajustes e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认合盖清理结果。请在设置中检查电源恢复，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認合蓋清理結果。請在設定中檢查電源恢復，然後重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันการล้างสถานะเมื่อปิดฝาจอไม่ได้ ตรวจการกู้คืนพลังงานในการตั้งค่าแล้วลองใหม่"
          }
        }
      }
    },
