        }
      }
    },
    "The previous key stops working. Your local assistants can reconnect while AI access stays enabled. The Home Assistant key stays the same.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous key stops working. Your local assistants can reconnect while AI access stays enabled. The Home Assistant key stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave anterior deja de funcionar. Tus asistentes locales podrán reconectarse mientras el acceso de IA siga activado. La clave de Home Assistant no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancienne clé cesse de fonctionner. Vos assistants locaux peuvent se reconnecter tant que l’accès IA reste activé. La clé Home Assistant reste inchangée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bisherige Schlüssel funktioniert nicht mehr. Lokale Assistenten können sich bei aktiviertem KI-Zugriff erneut verbinden. Der Home-Assistant-Schlüssel bleibt unverändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のキーは無効になります。AIアクセスが有効な間はローカルアシスタントが再接続できます。Home Assistantのキーは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 키는 더 이상 작동하지 않습니다. AI 접근이 켜져 있으면 로컬 어시스턴트가 다시 연결할 수 있습니다. Home Assistant 키는 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave anterior para de funcionar. Seus assistentes locais podem reconectar enquanto o acesso de IA estiver ativado. A chave do Home Assistant continua a mesma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧密钥将失效。只要 AI 访问保持开启，本地助手就能重新连接。Home Assistant 密钥不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊金鑰將失效。只要 AI 訪問保持開啓，本地助手就能重新連接。Home Assistant 金鑰不會改變。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์เดิมจะใช้ไม่ได้ ผู้ช่วยภายในเครื่องเชื่อมต่อใหม่ได้ขณะเปิดการเข้าถึง AI คีย์ Home Assistant ไม่เปลี่ยน"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave precedente smette di funzionare. Gli assistenti locali possono riconnettersi finché l’accesso all’IA resta attivo. La chiave di Home Assistant non cambia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige sleutel werkt niet meer. Je lokale assistenten kunnen opnieuw verbinding maken zolang AI-toegang ingeschakeld blijft. De sleutel voor Home Assistant blijft gelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedni klucz przestanie działać. Lokalni asystenci mogą połączyć się ponownie, dopóki dostęp AI jest włączony. Klucz Home Assistant pozostanie bez zmian."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki anahtar artık çalışmaz. Yapay zekâ erişimi açık kaldığı sürece yerel asistanlar yeniden bağlanabilir. Home Assistant anahtarı değişmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa cũ sẽ mất hiệu lực. Trợ lý cục bộ có thể kết nối lại nếu quyền truy cập AI vẫn bật. Khóa Home Assistant không đổi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci sebelumnya tidak lagi berlaku. Asisten lokal Anda dapat menyambungkan kembali selama akses AI tetap aktif. Kunci Home Assistant tidak berubah."
          }
        }
      }
    },
    "The previous local connection is still closing. Turn sharing off and on to retry.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous local connection is still closing. Turn sharing off and on to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión local anterior todavía se está cerrando. Desactiva y vuelve a activar el uso compartido para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion locale précédente est toujours en cours de fermeture. Désactivez puis réactivez le partage pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige lokale Verbindung wird noch geschlossen. Schalten Sie die Freigabe aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のローカル接続はまだ終了処理中です。共有をオフにしてからオンにして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 로컬 연결이 아직 종료 중입니다. 공유를 껐다 켜서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão local anterior ainda está sendo encerrada. Desative e reative o compartilhamento para tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的本地连接仍在关闭。请关闭并重新开启共享以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的本地連接仍在關閉。請關閉並重新開啓共享以重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อภายในเครื่องก่อนหน้ายังปิดไม่เสร็จ ปิดและเปิดการแชร์เพื่อลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione locale precedente è ancora in chiusura. Disattiva e riattiva la condivisione per riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
