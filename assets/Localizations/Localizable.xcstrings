    "An update is waiting. Choose Install Update and Relaunch, or skip it in the update window before quitting.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update is waiting. Choose Install Update and Relaunch, or skip it in the update window before quitting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una actualización pendiente. Elige Instalar actualización y reiniciar o sáltala en la ventana de actualización antes de salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour est en attente. Choisissez Installer la mise à jour et relancer, ou ignorez-la dans la fenêtre de mise à jour avant de quitter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Update wartet. „Update installieren und neu starten“ wählen oder das Update vor dem Beenden im Updatefenster überspringen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが待機中です。「アップデートをインストールして再起動」を選ぶか、終了前にアップデート画面でスキップしてください。"
