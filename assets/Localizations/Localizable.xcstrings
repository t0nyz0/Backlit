    "Saved recovery timing could not be verified. Restore your light, then turn closed-lid lighting off and on to retry.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved recovery timing could not be verified. Restore your light, then turn closed-lid lighting off and on to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el tiempo de recuperación guardado. Restaura la luz y luego desactiva y vuelve a activar la luz con tapa cerrada para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de restauration enregistré n’a pas pu être vérifié. Restaurez la lumière, puis désactivez et réactivez l’éclairage capot fermé pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Wiederherstellungszeit konnte nicht bestätigt werden. Licht wiederherstellen, dann Deckelbeleuchtung aus- und einschalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した復元時刻を確認できませんでした。ライトを復元し、画面を閉じた状態の点灯をオフにしてからオンにして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 복구 시간을 확인하지 못했습니다. 조명을 복원한 다음 덮개 닫힘 조명을 껐다 켜서 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o tempo de recuperação salvo. Restaure a luz e depois desative e reative a luz com a tampa fechada para tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证保存的恢复时间。请恢复灯光，然后关闭并重新开启合盖灯光以重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證保存的恢復時間。請恢復燈光，然後關閉並重新開啓合蓋燈光以重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันเวลาการกู้คืนที่บันทึกไว้ไม่ได้ กู้คืนไฟ แล้วปิดและเปิดไฟเมื่อปิดฝาจอเพื่อลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare i tempi di ripristino salvati. Ripristina la luce, poi disattiva e riattiva l’illuminazione a coperchio chiuso per riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen hersteltiming kon niet worden gecontroleerd. Herstel je licht en schakel de verlichting bij gesloten deksel uit en weer in om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować zapisanego czasu odzyskiwania. Przywróć podświetlenie, a następnie wyłącz i ponownie włącz podświetlanie przy zamkniętej pokrywie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı kurtarma zamanlaması doğrulanamadı. Işığı geri yükleyin, ardından kapak kapalıyken aydınlatmayı kapatıp açarak tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác minh được thời điểm khôi phục đã lưu. Hãy khôi phục đèn, rồi tắt và bật lại đèn khi đóng nắp để thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu pemulihan tersimpan tidak dapat diverifikasi. Pulihkan lampu, lalu matikan dan nyalakan kembali pencahayaan saat penutup tertutup untuk mencoba lagi."
          }
        }
      }
    },
