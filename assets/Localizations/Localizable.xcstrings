    "The saved safety check could not be recorded. Restore your light before retrying.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved safety check could not be recorded. Restore your light before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la comprobación de seguridad. Restaura la luz antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la vérification de sécurité. Restaurez la lumière avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitsprüfung konnte nicht gespeichert werden. Stellen Sie vor einem neuen Versuch das Licht wieder her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全確認の結果を保存できませんでした。再試行の前にライトを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 확인 결과를 저장하지 못했습니다. 다시 시도하기 전에 조명을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar a verificação de segurança. Restaure a luz antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法记录安全检查结果。重试前请恢复灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法記錄安全檢查結果。重試前請恢復燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกผลตรวจความปลอดภัยไม่ได้ กู้คืนไฟก่อนลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare il controllo di sicurezza salvato. Ripristina la luce prima di riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen veiligheidscontrole kon niet worden vastgelegd. Herstel je licht voordat je het opnieuw probeert."
