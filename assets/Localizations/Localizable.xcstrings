    "Update paused. Finish restoring the light, then retry installation.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update paused. Finish restoring the light, then retry installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización en pausa. Termina de restaurar la luz y vuelve a intentar la instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour suspendue. Terminez la restauration de la lumière, puis réessayez l’installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update pausiert. Lichtwiederherstellung abschließen, dann Installation erneut versuchen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを一時停止しました。ライトの復元を完了してからインストールを再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 일시 중지되었습니다. 조명 복원을 완료한 후 설치를 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização pausada. Termine de restaurar a luz e tente a instalação novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已暂停。完成灯光恢复后，请重试安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已暫停。完成燈光恢復後，請重試安裝。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตหยุดชั่วคราว กู้คืนไฟให้เสร็จแล้วลองติดตั้งอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento sospeso. Completa il ripristino della luce, poi riprova l’installazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Update gepauzeerd. Rond het herstel van het licht af en probeer de installatie opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja wstrzymana. Zakończ przywracanie podświetlenia, a potem ponów instalację."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme duraklatıldı. Işığı geri yüklemeyi bitirin, ardından yüklemeyi tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng cập nhật. Hoàn tất khôi phục đèn rồi thử cài đặt lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan dijeda. Selesaikan pemulihan lampu, lalu coba instal lagi."
          }
        }
      }
    },
