    "Optional ambient-light override. macOS asks for administrator approval. Your previous limits are saved.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional ambient-light override. macOS asks for administrator approval. Your previous limits are saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulación opcional del límite de luz ambiental. macOS solicita autorización de administrador. Se guardan tus límites anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dérogation facultative à la limite de lumière ambiante. macOS demande l’autorisation d’un administrateur. Vos limites précédentes sont sauvegardées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Umgehung der Umgebungslichtgrenze. macOS fragt nach Administratorfreigabe. Vorherige Grenzen werden gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の環境光制限の上書きです。macOSが管理者の承認を求めます。以前の制限値は保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변광 제한을 선택적으로 재정의합니다. macOS에서 관리자 승인을 요청하며 이전 제한값은 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituição opcional do limite de luz ambiente. O macOS pede autorização de administrador. Seus limites anteriores são salvos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的环境光亮度限制覆盖。macOS 会要求管理员批准，并保存之前的限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選的環境光亮度限制覆蓋。macOS 會要求管理員批准，並保存之前的限制。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกปลดข้อจำกัดตามแสงแวดล้อมได้ macOS จะขออนุมัติจากผู้ดูแลระบบ โดยบันทึกข้อจำกัดเดิมไว้"
          }
        }
      }
    },
