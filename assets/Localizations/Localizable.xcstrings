    "The AI connection key was replaced. Turn AI access off to stop all assistant connections.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI connection key was replaced. Turn AI access off to stop all assistant connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazó la clave de conexión de IA. Desactiva el acceso de IA para detener todas las conexiones de asistentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de connexion IA a été remplacée. Désactivez l’accès IA pour arrêter toutes les connexions d’assistants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Verbindungsschlüssel ersetzt. KI-Zugriff ausschalten, um alle Assistentenverbindungen zu beenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI接続キーを交換しました。すべてのアシスタント接続を停止するにはAIアクセスをオフにしてください。"
