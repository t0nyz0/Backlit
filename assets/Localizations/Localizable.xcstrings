    "When hidden, reopen Backlit from the Dock or Applications. Settings stays available from the app menu.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When hidden, reopen Backlit from the Dock or Applications. Settings stays available from the app menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está oculto, vuelve a abrir Backlit desde el Dock o Aplicaciones. Los ajustes siguen disponibles en el menú de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’icône est masquée, rouvrez Backlit depuis le Dock ou Applications. Les réglages restent accessibles dans le menu de l’app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ausgeblendet, Backlit über Dock oder Programme öffnen. Einstellungen bleiben im App-Menü verfügbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示の場合は、DockまたはアプリケーションからBacklitを開き直してください。設定はアプリのメニューから引き続き開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 경우 Dock이나 응용 프로그램에서 Backlit을 다시 여세요. 설정은 앱 메뉴에서 계속 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o ícone estiver oculto, reabra o Backlit pelo Dock ou Aplicativos. Os ajustes continuam disponíveis no menu do app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏后，可从 Dock 或“应用程序”重新打开 Backlit。应用菜单中仍可打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏後，可從 Dock 或“應用程式”重新打開 Backlit。應用菜單中仍可打開設定。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อซ่อนอยู่ ให้เปิด Backlit จาก Dock หรือโฟลเดอร์แอปพลิเคชันอีกครั้ง ยังเปิดการตั้งค่าจากเมนูแอปได้"
          }
        }
      }
    },
