            "value": "로고의 실제 덮개 상태를 복원하지 못했습니다. 복구 정보는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar o estado real da tampa para o logo. Os dados de recuperação foram preservados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复徽标的真实上盖状态。已保留恢复数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復標誌的真實上蓋狀態。已保留恢複數據。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คืนสถานะฝาจอจริงของโลโก้ไม่ได้ โดยคงข้อมูลกู้คืนไว้"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ripristinare lo stato effettivo del logo a coperchio chiuso. Il record di recupero è stato conservato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De werkelijke status van het logo bij gesloten deksel kon niet worden hersteld. De herstelinformatie is bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przywrócić rzeczywistego stanu logo przy zamkniętej pokrywie. Zachowano dane odzyskiwania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logonun gerçek kapak durumu geri yüklenemedi. Kurtarma bilgileri saklandı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khôi phục được trạng thái thực tế của đèn logo theo nắp. Thông tin khôi phục vẫn được giữ lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memulihkan status penutup yang sebenarnya pada pengendali logo. Catatan pemulihan dipertahankan."
          }
        }
      }
    },
    "Could not safely apply closed-lid lighting. Restore Light before retrying.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not safely apply closed-lid lighting. Restore Light before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aplicar de forma segura la luz con tapa cerrada. Usa Restaurar luz antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’activer l’éclairage capot fermé en toute sécurité. Utilisez Restaurer la lumière avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Deckelbeleuchtung konnte nicht sicher angewendet werden. Stellen Sie vor einem neuen Versuch das Licht wieder her."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を閉じた状態の点灯を安全に適用できませんでした。再試行の前にライトを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 닫힘 조명을 안전하게 적용하지 못했습니다. 다시 시도하기 전에 조명을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar com segurança a luz com a tampa fechada. Use Restaurar luz antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全应用合盖灯光。重试前请恢复灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全應用闔蓋燈光。重試前請恢復燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟเมื่อปิดฝาจออย่างปลอดภัยไม่ได้ กู้คืนไฟก่อนลองใหม่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile attivare in sicurezza l’illuminazione a coperchio chiuso. Seleziona «Ripristina luce» prima di riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het licht bij gesloten deksel kon niet veilig worden ingeschakeld. Kies ‘Licht herstellen’ voordat je het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się bezpiecznie włączyć podświetlania przy zamkniętej pokrywie. Przed ponowną próbą wybierz „Przywróć podświetlenie”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalıyken aydınlatma güvenli şekilde uygulanamadı. Tekrar denemeden önce “Işığı Geri Yükle”yi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bật đèn khi đóng nắp một cách an toàn. Chọn Khôi phục đèn trước khi thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyalakan lampu dengan aman saat penutup tertutup. Pilih Pulihkan Lampu sebelum mencoba lagi."
          }
        }
      }
    },
