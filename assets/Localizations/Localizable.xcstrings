    "The previous key stops working. Your local assistants can reconnect while AI access stays enabled. The Home Assistant key stays the same.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous key stops working. Your local assistants can reconnect while AI access stays enabled. The Home Assistant key stays the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave anterior deja de funcionar. Tus asistentes locales podrán reconectarse mientras el acceso de IA siga activado. La clave de Home Assistant no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancienne clé cesse de fonctionner. Vos assistants locaux peuvent se reconnecter tant que l’accès IA reste activé. La clé Home Assistant reste inchangée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bisherige Schlüssel funktioniert nicht mehr. Lokale Assistenten können sich bei aktiviertem KI-Zugriff erneut verbinden. Der Home-Assistant-Schlüssel bleibt unverändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のキーは無効になります。AIアクセスが有効な間はローカルアシスタントが再接続できます。Home Assistantのキーは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 키는 더 이상 작동하지 않습니다. AI 접근이 켜져 있으면 로컬 어시스턴트가 다시 연결할 수 있습니다. Home Assistant 키는 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave anterior para de funcionar. Seus assistentes locais podem reconectar enquanto o acesso de IA estiver ativado. A chave do Home Assistant continua a mesma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧密钥将失效。只要 AI 访问保持开启，本地助手就能重新连接。Home Assistant 密钥不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊金鑰將失效。只要 AI 訪問保持開啓，本地助手就能重新連接。Home Assistant 金鑰不會改變。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์เดิมจะใช้ไม่ได้ ผู้ช่วยภายในเครื่องเชื่อมต่อใหม่ได้ขณะเปิดการเข้าถึง AI คีย์ Home Assistant ไม่เปลี่ยน"
          }
        }
      }
    },
    "The previous local connection is still closing. Turn sharing off and on to retry.": {
