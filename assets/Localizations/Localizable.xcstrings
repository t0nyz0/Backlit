          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedien je licht op verzoek of laat het automatisch je programmeeractiviteit weergeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
