    "Paused after an error. Restore your light before retrying.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused after an error. Restore your light before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado tras un error. Restaura la luz antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu après une erreur. Restaurez la lumière avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Fehler pausiert. Vor einem neuen Versuch das Licht wiederherstellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー後に一時停止しています。再試行の前にライトを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류 후 일시 중지되었습니다. 다시 시도하기 전에 조명을 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado após um erro. Restaure a luz antes de tentar novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因错误暂停。重试前请恢复灯光。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因錯誤暫停。重試前請恢復燈光。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดชั่วคราวหลังข้อผิดพลาด กู้คืนไฟก่อนลองใหม่"
          }
        }
      }
    },
    "Paused after an error. Turn “Keep logo on with lid closed” off and on after recovery.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused after an error. Turn “Keep logo on with lid closed” off and on after recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado tras un error. Después de la recuperación, desactiva y vuelve a activar «Mantener el logo encendido con la tapa cerrada»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu après une erreur. Après la restauration, désactivez puis réactivez « Garder le logo allumé avec le capot fermé »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem Fehler pausiert. Nach der Wiederherstellung die Deckelbeleuchtung aus- und einschalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー後に一時停止しています。復元後、「画面を閉じてもロゴを点灯」をオフにしてからオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류 후 일시 중지되었습니다. 복구 후 ‘덮개를 닫아도 로고 켜기’를 껐다 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado após um erro. Após a recuperação, desative e reative “Manter logo aceso com a tampa fechada”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因错误暂停。恢复后请关闭并重新开启“合盖时保持徽标亮起”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因錯誤暫停。恢復後請關閉並重新開啓“合蓋時保持徽標亮起”。"
          }
        },
        "th": {
