          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit bağlantısı kopyalandı. Özel uygulama bağlantılarını destekleyen bir başlatıcıyla kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã sao chép liên kết Backlit. Hãy dùng với trình khởi chạy hỗ trợ liên kết ứng dụng tùy chỉnh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan Backlit disalin. Gunakan dengan peluncur yang mendukung tautan app khusus."
          }
        }
      }
    },
    "Backlit uses system playback audio for Music mode. It does not save or transmit screen or audio content.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit uses system playback audio for Music mode. It does not save or transmit screen or audio content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit usa el audio de reproducción del sistema en el modo Música. No guarda ni transmite contenido de pantalla ni audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit utilise le son du système pour le mode Musique. Il n’enregistre ni ne transmet le contenu de l’écran ou le son."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit verwendet Systemwiedergabe-Audio für den Musikmodus. Bildschirm- und Audioinhalte werden weder gespeichert noch übertragen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlitは音楽モードでシステムの再生音を使用します。画面や音声の内容を保存・送信することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit은 음악 모드에 시스템 재생 오디오를 사용합니다. 화면이나 오디오 내용을 저장하거나 전송하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Backlit usa o áudio reproduzido pelo sistema no modo Música. Não salva nem transmite conteúdo da tela ou áudio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 在音乐模式中使用系统播放音频，不保存或传输屏幕或音频内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit 在音樂模式中使用系統播放音訊，不保存或傳輸螢幕或音訊內容。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit ใช้เสียงที่ระบบเล่นสำหรับโหมดเพลง ไม่บันทึกหรือส่งเนื้อหาหน้าจอหรือเสียง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit usa l’audio riprodotto dal sistema in modalità Musica. Non salva né trasmette contenuti dello schermo o audio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit gebruikt afgespeeld systeemgeluid voor de muziekmodus. Scherm- en audio-inhoud worden niet opgeslagen of verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit wykorzystuje dźwięk odtwarzany przez system w trybie Muzyka. Nie zapisuje ani nie przesyła obrazu ekranu ani dźwięku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit, Müzik modu için sistemde çalınan sesi kullanır. Ekran veya ses içeriğini kaydetmez ya da iletmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit dùng âm thanh đang phát trên hệ thống cho chế độ Nhạc. Ứng dụng không lưu hay truyền nội dung màn hình hoặc âm thanh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit menggunakan audio yang diputar sistem untuk mode Musik. Backlit tidak menyimpan atau mengirim konten layar maupun audio."
          }
        }
      }
    },
    "Backlit will reconnect when your Mac is awake and unlocked.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit will reconnect when your Mac is awake and unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit volverá a conectarse cuando el Mac esté activo y desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Backlit se reconnectera lorsque votre Mac sera éveillé et déverrouillé."
          }
        },
        "de": {
