          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认：充电时自动脉动，周期 6 秒，最低亮度 0%，关闭充电达标提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設：充電時自動脈動，週期 6 秒，最低亮度 0%，關閉充電達標提示。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้น: จังหวะชาร์จอัตโนมัติ รอบ 6 วินาที หรี่ถึง 0% และปิดสัญญาณชาร์จถึงเป้าหมาย"
          }
        }
      }
    },
