    },
    "Remembered. Paused for your Mac’s safety settings.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remembered. Paused for your Mac’s safety settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. En pausa por los ajustes de seguridad del Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé. Suspendu selon les réglages de sécurité de votre Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Wegen der Sicherheitseinstellungen Ihres Mac pausiert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存しました。Macの安全設定により一時停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장했습니다. Mac 안전 설정으로 일시 중지되었습니다."
          }
