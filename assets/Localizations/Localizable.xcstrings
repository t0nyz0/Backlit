    "Input Monitoring is allowed, but macOS could not create the typing event listener. Reopen Backlit and retry.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input Monitoring is allowed, but macOS could not create the typing event listener. Reopen Backlit and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorización de entrada está permitida, pero macOS no pudo crear el receptor de eventos de escritura. Vuelve a abrir Backlit y reintenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillance de l’entrée est autorisée, mais macOS n’a pas pu créer le récepteur d’événements de saisie. Rouvrez Backlit et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabeüberwachung ist erlaubt, aber macOS konnte keinen Listener für Tippereignisse erstellen. Öffnen Sie Backlit erneut und versuchen Sie es noch einmal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力監視は許可されていますが、macOSがタイピングイベントのリスナーを作成できませんでした。Backlitを開き直して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 모니터링은 허용되었지만 macOS가 타이핑 이벤트 리스너를 만들지 못했습니다. Backlit을 다시 열고 재시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Monitoramento de Entrada está permitido, mas o macOS não conseguiu criar o receptor de eventos de digitação. Reabra o Backlit e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许输入监控，但 macOS 无法创建打字事件监听器。请重新打开 Backlit 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許輸入監控，但 macOS 無法創建打字事件監聽器。請重新打開 Backlit 後重試。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการตรวจดูอินพุตแล้ว แต่ macOS สร้างตัวรับเหตุการณ์การพิมพ์ไม่ได้ เปิด Backlit ใหม่แล้วลองอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitoraggio input è consentito, ma macOS non è riuscito a creare il listener degli eventi di digitazione. Riapri Backlit e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoercontrole is toegestaan, maar macOS kon niet luisteren naar typgebeurtenissen. Open Backlit opnieuw en probeer het nogmaals."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienie Monitorowanie wprowadzania jest aktywne, ale macOS nie mógł utworzyć nasłuchu zdarzeń klawiatury. Uruchom Backlit ponownie i spróbuj jeszcze raz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi İzleme izni var, ancak macOS yazma olayları için dinleyici oluşturamadı. Backlit’i yeniden açıp tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cấp quyền Giám sát đầu vào nhưng macOS không tạo được trình lắng nghe sự kiện gõ phím. Hãy mở lại Backlit và thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemantauan Input diizinkan, tetapi macOS tidak dapat membuat pemantau peristiwa ketikan. Buka kembali Backlit dan coba lagi."
          }
        }
      }
    },
