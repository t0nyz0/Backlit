    "Previous effects are still cleaning up. Waiting before another safety check.": {
      "comment": "Current Backlit user-visible status or actionable error. Preserve safety uncertainty, permission requirements and retained recovery state. This text is translated only for display; protocol and diagnostic payloads are unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous effects are still cleaning up. Waiting before another safety check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún se están limpiando los efectos anteriores. Esperando antes de otra comprobación de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage des effets précédents est toujours en cours. En attente avant une nouvelle vérification de sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorherige Effekte werden noch bereinigt. Warte vor der nächsten Sicherheitsprüfung."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のエフェクトの後処理が続いています。次の安全確認まで待機しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 효과가 아직 정리 중입니다. 다음 안전 확인 전에 기다리는 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza dos efeitos anteriores ainda está em andamento. Aguardando antes de outra verificação de segurança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的灯效仍在清理。正在等待下一次安全检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的燈效仍在清理。正在等待下一次安全檢查。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอฟเฟ็กต์ก่อนหน้ายังล้างสถานะอยู่ กำลังรอก่อนตรวจความปลอดภัยอีกครั้ง"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristino degli effetti precedenti ancora in corso. Prossimo controllo di sicurezza in attesa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere effecten worden nog opgeruimd. De volgende veiligheidscontrole wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa porządkowanie po poprzednich efektach. Oczekiwanie przed następną kontrolą bezpieczeństwa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki efektlerin temizliği sürüyor. Sonraki güvenlik denetimi için bekleniyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hiệu ứng trước vẫn đang được dọn dẹp. Đang chờ lần kiểm tra an toàn tiếp theo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Efek sebelumnya masih dibersihkan. Menunggu sebelum pemeriksaan keselamatan berikutnya."
          }
        }
      }
    },
