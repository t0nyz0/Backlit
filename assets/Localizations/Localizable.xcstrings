          "stringUnit": {
            "state": "translated",
            "value": "Typing was paused by macOS; turn typing response off and on to resume"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pausó la escritura; desactiva y vuelve a activar la respuesta a la escritura para reanudarla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a suspendu la saisie ; désactivez puis réactivez la réaction à la saisie pour reprendre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Tippreaktion pausiert. Schalten Sie sie aus und wieder ein, um fortzufahren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSによりタイピングへの反応が一時停止しました。再開するにはオフにしてからオンにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 타이핑을 일시 중지했습니다. 타이핑 반응을 껐다 켜서 다시 시작하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pausou a digitação; desative e reative a resposta à digitação para retomar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已暂停打字响应；请关闭后重新开启以恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已暫停打字響應；請關閉後重新開啓以恢復"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS หยุดการพิมพ์ชั่วคราว ปิดและเปิดการตอบสนองต่อการพิมพ์เพื่อทำงานต่อ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha sospeso la digitazione. Disattiva e riattiva la risposta alla digitazione per riprendere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft het typen gepauzeerd. Schakel de reactie op typen uit en weer in om door te gaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS wstrzymał reakcję na pisanie. Wyłącz ją i włącz ponownie, aby ją wznowić"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS yazma tepkisini duraklattı; sürdürmek için yazma tepkisini kapatıp açın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS đã tạm dừng nhận thao tác gõ phím; hãy tắt và bật lại phản hồi khi gõ phím để tiếp tục"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Respons ketikan dijeda oleh macOS; matikan lalu nyalakan kembali untuk melanjutkan"
          }
        }
      }
    },
    "Unplugged, logo brightness matches battery charge down to 0%. Manual brightness does not affect Battery mode.": {
      "comment": "Backlit interface text. Keep product names and technical identifiers unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unplugged, logo brightness matches battery charge down to 0%. Manual brightness does not affect Battery mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin alimentación externa, el brillo del logo coincide con la carga de la batería hasta el 0%. El brillo manual no afecta al modo Batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors secteur, la luminosité du logo suit la charge de la batterie jusqu’à 0 %. Le réglage manuel n’affecte pas le mode Batterie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Netzteil folgt die Logohelligkeit dem Akkustand bis auf 0 %. Die manuelle Helligkeit beeinflusst den Akkumodus nicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源を外すと、ロゴの明るさは0%までバッテリー残量に連動します。手動の明るさ設定はバッテリーモードに影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원을 분리하면 로고 밝기는 0%까지 배터리 잔량을 따릅니다. 수동 밝기는 배터리 모드에 영향을 주지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado da energia, o brilho do logo acompanha a carga da bateria até 0%. O brilho manual não afeta o modo Bateria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拔下电源后，徽标亮度跟随电量降至 0%。手动亮度不会影响电池模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拔下電源後，徽標亮度跟隨電量降至 0%。手動亮度不會影響電池模式。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อถอดปลั๊ก ความสว่างโลโก้ปรับตามระดับแบตเตอรี่ลงถึง 0% การปรับความสว่างเองไม่มีผลต่อโหมดแบตเตอรี่"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l’alimentatore scollegato, la luminosità del logo segue la carica della batteria fino allo 0%. La luminosità manuale non influisce sulla modalità Batteria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder netvoeding volgt de logohelderheid de batterijlading tot 0%. Handmatige helderheid heeft geen invloed op de modus Batterij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy odłączonym zasilaniu jasność logo odpowiada poziomowi naładowania baterii, aż do 0%. Ręczne ustawienie jasności nie wpływa na tryb Bateria."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç bağlantısı kesildiğinde logo parlaklığı, %0’a kadar pil doluluk düzeyine uyar. Elle ayarlanan parlaklık Pil modunu etkilemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi rút nguồn, độ sáng đèn logo theo mức pin đến 0%. Mức sáng chỉnh tay không ảnh hưởng đến chế độ Pin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat daya dicabut, kecerahan logo mengikuti tingkat baterai hingga 0%. Kecerahan manual tidak memengaruhi mode Baterai."
          }
        }
      }
    },
